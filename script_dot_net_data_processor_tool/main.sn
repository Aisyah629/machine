// Script.NET Data Processor Tool
// Main entry point

using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;

public class DataProcessor
{
    public static void Main(string[] args)
    {
        Console.WriteLine("Script.NET Data Processor Tool Started");

        if (args.Length == 0)
        {
            Console.WriteLine("Usage: main.sn <input_file> [output_file]");
            return;
        }

        string inputFile = args[0];
        string outputFile = args.Length > 1 ? args[1] : "output.txt";

        try
        {
            var data = LoadData(inputFile);
            var processedData = ProcessData(data);
            SaveData(processedData, outputFile);
            Console.WriteLine($"Data processing completed. Output saved to {outputFile}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private static List<string> LoadData(string filePath)
    {
        if (!File.Exists(filePath))
        {
            throw new FileNotFoundException($"File not found: {filePath}");
        }
        return File.ReadAllLines(filePath).ToList();
    }

    private static List<string> ProcessData(List<string> data)
    {
        // Example processing: Filter out empty lines and trim whitespace
        return data
            .Select(line => line.Trim())
            .Where(line => !string.IsNullOrEmpty(line))
            .ToList();
    }

    private static void SaveData(List<string> data, string filePath)
    {
        File.WriteAllLines(filePath, data);
    }
}
