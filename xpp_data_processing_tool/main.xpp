using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;

namespace XppDataProcessing
{
    public class DataProcessor
    {
        public static void Main(string[] args)
        {
            Console.WriteLine("Initializing X++ Data Processing Tool...");

            if (args.Length == 0)
            {
                Console.WriteLine("Usage: XppDataProcessor <input_file> <output_file>");
                return;
            }

            string inputFile = args[0];
            string outputFile = args[1];

            try
            {
                // Ingest Data
                var rawData = IngestData(inputFile);
                Console.WriteLine($"Ingested {rawData.Count} records.");

                // Transform Data
                var processedData = TransformData(rawData);
                Console.WriteLine("Data transformation complete.");

                // Validate Data
                var isValid = ValidateData(processedData);
                if (isValid)
                {
                    // Output Data
                    OutputData(outputFile, processedData);
                    Console.WriteLine($"Successfully wrote data to {outputFile}.");
                }
                else
                {
                    Console.WriteLine("Data validation failed.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }

        private static List<string> IngestData(string filePath)
        {
            if (!File.Exists(filePath))
            {
                throw new FileNotFoundException($"Input file not found: {filePath}");
            }

            return File.ReadLines(filePath).ToList();
        }

        private static List<string> TransformData(List<string> rawData)
        {
            // Simple transformation: Uppercase each line
            return rawData.Select(line => line.ToUpper().Trim()).ToList();
        }

        private static bool ValidateData(List<string> data)
        {
            // Simple validation: Ensure no empty lines after transformation
            return data.All(line => !string.IsNullOrEmpty(line));
        }

        private static void OutputData(string filePath, List<string> data)
        {
            File.WriteAllLines(filePath, data);
        }
    }
}
