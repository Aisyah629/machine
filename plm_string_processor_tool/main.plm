DECLARE STRING_LENGTH FIXED(4);
DECLARE BUFFER(256) CHARACTER;
DECLARE TOKEN_BUFFER(256) CHARACTER;
DECLARE CURRENT_POS FIXED(4);
DECLARE DELIMITER CHARACTER;
DECLARE RESULT_LENGTH FIXED(4);
DECLARE I FIXED(4);

BEGIN
  CURRENT_POS = 1;
  STRING_LENGTH = 0;
  RESULT_LENGTH = 0;
  
  CALL INIT_BUFFER(BUFFER, DELIMITER);
  CALL PROCESS_INPUT(BUFFER, TOKEN_BUFFER, CURRENT_POS, STRING_LENGTH, RESULT_LENGTH);
  
  RETURN;
END;

SUBROUTINE INIT_BUFFER(BUF, DELIM);
DECLARE BUF(256) CHARACTER;
DECLARE DELIM CHARACTER;
DECLARE J FIXED(4);

  DELIM = ',';
  DO J = 1 TO 256;
    BUF(J) = '0'
  END;
  RETURN;
END INIT_BUFFER;

SUBROUTINE PROCESS_INPUT(STRING_BUFFER, TOKEN_BUFFER, POS, STR_LEN, OUT_LEN);
DECLARE STRING_BUFFER(256) CHARACTER;
DECLARE TOKEN_BUFFER(256) CHARACTER;
DECLARE POS FIXED(4);
DECLARE STR_LEN FIXED(4);
DECLARE OUT_LEN FIXED(4);
DECLARE K FIXED(4);
DECLARE CHAR_COUNT FIXED(4);

  CHAR_COUNT = 0;
  OUT_LEN = 0;
  
  DO WHILE POS <= STR_LEN AND POS <= 256;
    IF STRING_BUFFER(POS) ^= ',' THEN
      DO;
        CHAR_COUNT = CHAR_COUNT + 1;
        IF CHAR_COUNT <= 64 THEN
          TOKEN_BUFFER(CHAR_COUNT) = STRING_BUFFER(POS);
      END
    ELSE
      DO;
        IF CHAR_COUNT > 0 THEN
          DO;
            OUT_LEN = OUT_LEN + 1;
            STRING_BUFFER(OUT_LEN) = TOKEN_BUFFER(CHAR_COUNT);
            CHAR_COUNT = 0;
          END;
      END;
    POS = POS + 1;
  END;
  
  RETURN;
END PROCESS_INPUT;
