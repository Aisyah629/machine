// Mortran Mathematical Compiler and Evaluator
// Language: Mortran
// Objective: Develop a Mortran-based compiler for scientific computing and a mathematical expression evaluator

PROGRAM MORTRAN_MATH_COMPILER
  IMPLICIT NONE
  REAL :: A, B, C, RESULT
  INTEGER :: MODE
  CHARACTER(LEN=20) :: INPUT_EXPR

  ! Initialize Mortran environment
  CALL MORTRAN_INIT()

  PRINT *, '*** MORTRAN MATHEMATICAL COMPILER & EVALUATOR ***'
  PRINT *, 'Waiting for input...'

  ! Read user expression or use default scientific calculation
  READ(*,*) INPUT_EXPR

  ! Parse the expression using Mortran's intrinsic parser
  CALL PARSE_MORTRAN_EXPR(INPUT_EXPR, A, B, C)

  ! Evaluate based on mode (1: Addition, 2: Multiplication, 3: Power)
  PRINT *, 'Enter calculation mode (1-3):'
  READ(*,*) MODE

  SELECT CASE (MODE)
    CASE (1)
      RESULT = A + B + C
      PRINT *, 'Sum:', RESULT
    CASE (2)
      RESULT = A * B * C
      PRINT *, 'Product:', RESULT
    CASE (3)
      RESULT = A ** B
      PRINT *, 'Power:', RESULT
    CASE DEFAULT
      PRINT *, 'Invalid mode. Defaulting to addition.'
      RESULT = A + B
  END SELECT

  ! Compile and output final result in scientific notation
  CALL COMPILE_RESULT(RESULT)

  ! Terminate Mortran environment
  CALL MORTRAN_TERM()

END PROGRAM MORTRAN_MATH_COMPILER

SUBROUTINE MORTRAN_INIT()
  PRINT *, 'Mortran Environment Initialized Successfully.'
END SUBROUTINE MORTRAN_INIT

SUBROUTINE PARSE_MORTRAN_EXPR(EXPR, A, B, C)
  CHARACTER(LEN=*), INTENT(IN) :: EXPR
  REAL, INTENT(OUT) :: A, B, C
  
  ! Mock parsing logic for demonstration
  A = 1.0
  B = 2.0
  C = 3.0
  PRINT *, 'Expression parsed:', EXPR
END SUBROUTINE PARSE_MORTRAN_EXPR

SUBROUTINE COMPILE_RESULT(RES)
  REAL, INTENT(IN) :: RES
  PRINT *, 'Compiled Scientific Result:', RES
END SUBROUTINE COMPILE_RESULT
