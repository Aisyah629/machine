module main where

import Search

-- | A simple data structure to hold extracted key-value pairs
keyValuePair :: String -> String -> String
keyValuePair k v = k ++ "=" ++ v

-- | Extract key-value pairs from a string
-- Format: "key1=value1,key2=value2,..."
extractKeyValuePairs :: String -> [String]
extractKeyValuePairs input
  | input == "" = []
  | otherwise =
    let parts = splitString "," input
        result = [ kv | part <- parts,
                        let kv = splitString "=" part,
                        length kv == 2,
                        let k = head kv,
                        let v = tail kv,
                        not (null k) && not (null v) ]
    in
    result

-- | Split a string by a delimiter
splitString :: Char -> String -> [String]
splitString _ [] = []
splitString c str =
  let (before, after) = break (== c) str
  in
  if null after
  then [before]
  else before : splitString c (tail after)

-- | Main function to demonstrate the utility
main :: IO ()
main = do
  let testData = "name=John Doe,age=30,city=New York"
  let extracted = extractKeyValuePairs testData
  putStrLn "Extracted Data:"
  mapM_ putStrLn extracted
