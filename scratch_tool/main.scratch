"""
Scratch Tool - Interactive Visual Programming Environment

This script simulates the core structure of a Scratch-like programming environment.
It defines the basic blocks, event handlers, and simulation loop.
"""

# --- Block Definitions ---
# In a real implementation, these would be visual blocks in a UI.
# Here, we define them as classes for structure and logic.

class Block:
    def __init__(self, name, category, color, handler=None):
        self.name = name
        self.category = category
        self.color = color
        self.handler = handler
        self.inputs = []  # Stores connections to other blocks or inputs

    def execute(self, simulation_state):
        if self.handler:
            return self.handler(self, simulation_state)
        return simulation_state

class EventBlock(Block):
    """Blocks that trigger scripts based on events."""
    pass

class MotionBlock(Block):
    """Blocks that control the motion of sprites."""
    pass

class LooksBlock(Block):
    """Blocks that control how sprites look."""
    pass

class ControlBlock(Block):
    """Blocks for loops, conditionals, and other control structures."""
    pass

# --- Block Instances ---
# Example blocks for a simple program

# Events
when_green_flag_clicked = EventBlock("When Green Flag Clicked", "Events", "#4C97FF", lambda b, s: s)
when_key_pressed = EventBlock("When Key Pressed", "Events", "#4C97FF", lambda b, s: s)
when_this_sprite_clicked = EventBlock("When This Sprite Clicked", "Events", "#4C97FF", lambda b, s: s)

# Motion
move_steps = MotionBlock("Move 10 Steps", "Motion", "#4C97FF", lambda b, s: {
    **s, 
    'x_position': s.get('x_position', 0) + 10,
    'x_speed': s.get('x_speed', 0) + 0,
    'y_speed': s.get('y_speed', 0) + 0
})
point_in_direction = MotionBlock("Point in Direction", "Motion", "#4C97FF", lambda b, s: {
    **s, 
    'direction': 90
})
go_to_xy = MotionBlock("Go to x: y:", "Motion", "#4C97FF", lambda b, s: {
    **s, 
    'x_position': s.get('inputs', {}).get('x', 0),
    'y_position': s.get('inputs', {}).get('y', 0)
})

# Looks
say = LooksBlock("Say Hello!", "Looks", "#9966FF", lambda b, s: {
    **s, 
    'bubble_text': "Hello!"
})
think = LooksBlock("Think Hmm...", "Looks", "#9966FF", lambda b, s: {
    **s, 
    'bubble_text': "Hmm..."
})
change_size_by = LooksBlock("Change Size by 10", "Looks", "#9966FF", lambda b, s: {
    **s, 
    'size': min(200, max(0, s.get('size', 100) + 10))
})

# Control
repeat = ControlBlock("Repeat 10", "Control", "#FFAB19", lambda b, s: {
    **s, 
    'loops': s.get('loops', 0) + 1
})
if_else = ControlBlock("If Then Else", "Control", "#FFAB19", lambda b, s: s)
forever = ControlBlock("Forever", "Control", "#FFAB19", lambda b, s: s)
wait_seconds = ControlBlock("Wait 1 Sec", "Control", "#FFAB19", lambda b, s: {
    **s, 
    'time_elapsed': s.get('time_elapsed', 0) + 1
})

# --- Script Definition ---
# A script is a list of blocks connected in sequence.

def create_default_script():
    """Creates a default script for demonstration."""
    return [
        when_green_flag_clicked,
        move_steps,
        move_steps,
        point_in_direction,
        say,
        wait_seconds,
        think,
        repeat  # In a real interpreter, this would wrap blocks in a loop
    ]

# --- Simulation Engine ---

class SimulationState:
    """Represents the state of the simulation."""
    def __init__(self):
        self.x_position = 0
        self.y_position = 0
        self.direction = 90
        self.size = 100
        self.bubble_text = ""
        self.time_elapsed = 0
        self.loops = 0
        self.running = False

    def update(self, block_result):
        self.update(block_result)
        self.running = False

# --- Main Program ---

def main():
    print("Scratch Tool Initialized")
    print("------------------------")
    
    # Create a default script
    script = create_default_script()
    
    # Initialize simulation state
    sim_state = SimulationState()
    
    print(f"Script loaded with {len(script)} blocks.")
    print("Blocks:", [b.name for b in script])
    
    # Simulate execution
    print("\nSimulating script execution...")
    sim_state.running = True
    
    try:
        for block in script:
            print(f"\nExecuting: {block.name}")
            sim_state = block.execute(sim_state)
            print(f"State: X={sim_state.x_position}, Y={sim_state.y_position}, Direction={sim_state.direction}, Size={sim_state.size}")
    except Exception as e:
        print(f"Execution error: {e}")
    finally:
        sim_state.running = False
        print("\nSimulation complete.")
        print(f"Final State: {sim_state.__dict__}")

if __name__ == "__main__":
    main()
