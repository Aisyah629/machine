statechart TextCleaner {\n    initial state CleaningInitial {\n        transition on event 'DataReceived' to CleaningPreprocess\n    }\n    \n    state CleaningPreprocess {\n        entry: Log('Starting preprocessing...');\n        transition on event 'PreprocessComplete' to CleaningTrimming\n    }\n    \n    state CleaningTrimming {\n        entry: Log('Trimming whitespace...');\n        transition on event 'TrimComplete' to CleaningNormalizing\n    }\n    \n    state CleaningNormalizing {\n        entry: Log('Normalizing line endings...');\n        transition on event 'NormalizeComplete' to CleaningFinal\n    }\n    \n    state CleaningFinal {\n        entry: Log('Output generated.');\n        transition on event 'ExportRequested' to CleaningOutputReady\n    }\n    \n    state CleaningOutputReady {\n        entry: Log('Output ready for downstream process.');\n    }\n}\n
