import java.io.File;
import java.io.BufferedReader;
import java.io.FileReader;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * BeanShell Data Extraction Utility
 * 
 * This script demonstrates parsing and extracting data from structured text.
 * It handles CSV-like formats and allows extraction by column index.
 */

// Configuration
String targetFile = "data.txt";
int extractColumn = 1; // Column to extract (0-indexed)

// Method to parse data from a string
List<Map<String, String>> parseData(String rawData) {
    List<Map<String, String>> records = new ArrayList<Map<String, String>>();
    String[] lines = rawData.split("\\n");
    
    for (String line : lines) {
        line = line.trim();
        if (line.isEmpty() || line.startsWith("#")) {
            continue;
        }
        
        String[] fields = line.split(",");
        Map<String, String> record = new HashMap<String, String>();
        
        // Create generic keys if headers are not defined
        for (int i = 0; i < fields.length; i++) {
            record.put("col_" + i, fields[i].trim());
        }
        
        records.add(record);
    }
    
    return records;
}

// Method to extract specific column from parsed data
List<String> extractColumn(List<Map<String, String>> records, int colIndex) {
    List<String> values = new ArrayList<String>();
    
    for (Map<String, String> record : records) {
        String key = "col_" + colIndex;
        if (record.containsKey(key)) {
            values.add(record.get(key));
        }
    }
    
    return values;
}

// Main execution logic
try {
    File file = new File(targetFile);
    String data = "";
    
    // In a real BeanShell environment, we might use a pre-loaded variable or read from file
    // For this script, we'll simulate reading from file if it exists
    if (file.exists()) {
        BufferedReader reader = new BufferedReader(new FileReader(file));
        StringBuilder sb = new StringBuilder();
        String line;
        while ((line = reader.readLine()) != null) {
            sb.append(line).append("\\n");
        }
        reader.close();
        data = sb.toString().trim();
    } else {
        // Sample data if file doesn't exist
        data = "Name,Age,City\\nAlice,30,New York\\nBob,25,London\\nCharlie,35,Paris";
    }
    
    // Parse the data
    List<Map<String, String>> records = parseData(data);
    
    // Extract the specified column
    List<String> extractedValues = extractColumn(records, extractColumn);
    
    // Output results
    println("Extracted Data from Column " + extractColumn + ":");
    for (String value : extractedValues) {
        println("  - " + value);
    }
    
} catch (Exception e) {
    println("Error during data extraction: " + e.getMessage());
    e.printStackTrace();
}
