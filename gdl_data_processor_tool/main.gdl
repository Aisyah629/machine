;; GDL Data Processor Tool
;; Main Entry Point

(defpackage :gdl-data-processor
  (:use :cl :gdl))

(in-package :gdl-data-processor)

;; Function to filter data based on criteria
(defun filter-data (data criteria)
  (let ((filtered ()))
    (dolist (entry data)
      (when (funcall criteria entry)
        (push entry filtered)))
    (nreverse filtered)))

;; Function to aggregate data by key
(defun aggregate-data (data key-function value-function)
  (let ((groups (make-hash-table :test 'equal)))
    (dolist (entry data)
      (let* ((key (funcall key-function entry))
             (val (funcall value-function entry))
             (group (gethash key groups)))
        (if group
            (setf (gethash key groups) (cons val group))
            (setf (gethash key groups) (list val)))))
    groups))

;; Function to transform data structure
(defun transform-data (data transformer)
  (mapcar transformer data))

;; Main processing loop
(defun process-data (input-data transformer filter-criteria)
  (let ((transformed (if transformer (transform-data input-data transformer) input-data)))
    (if filter-criteria
        (filter-data transformed filter-criteria)
        transformed)))

;; Export functions
(provide :gdl-data-processor)
