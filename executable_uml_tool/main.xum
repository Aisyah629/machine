import System;
import System.Collections.Generic;

namespace ExecutableUML.SelfHealing
{
    // Represents an error detected in the system
    class ErrorEvent
    {
        public string ErrorType { get; set; }
        public string Description { get; set; }
        public DateTime Timestamp { get; set; }

        public ErrorEvent(string type, string desc)
        {
            ErrorType = type;
            Description = desc;
            Timestamp = DateTime.Now;
        }
    }

    // Enumerates possible recovery actions
    enum RecoveryActionType
    {
        RestartService,
        ResetState,
        FallbackToDefault,
        NotifyAdmin
    }

    // Encapsulates a specific recovery action
    class RecoveryAction
    {
        public RecoveryActionType ActionType { get; set; }
        public string ActionDescription { get; set; }

        public RecoveryAction(RecoveryActionType type, string desc)
        {
            ActionType = type;
            ActionDescription = desc;
        }

        public void Execute()
        {
            switch (ActionType)
            {
                case RecoveryActionType.RestartService:
                    Console.WriteLine($"Restarting service: {ActionDescription}");
                    // Simulate service restart
                    break;
                case RecoveryActionType.ResetState:
                    Console.WriteLine($"Resetting state: {ActionDescription}");
                    // Simulate state reset
                    break;
                case RecoveryActionType.FallbackToDefault:
                    Console.WriteLine($"Falling back to default: {ActionDescription}");
                    // Simulate fallback
                    break;
                case RecoveryActionType.NotifyAdmin:
                    Console.WriteLine($"Notifying admin: {ActionDescription}");
                    // Simulate notification
                    break;
                default:
                    break;
            }
        }
    }

    // Maps error types to recovery actions
    class ErrorRecoveryMap
    {
        private Dictionary<string, List<RecoveryAction>> recoveryMap;

        public ErrorRecoveryMap()
        {
            recoveryMap = new Dictionary<string, List<RecoveryAction>>();
            // Populate with default mappings
            recoveryMap.Add("NullPointerException", new List<RecoveryAction>
            {
                new RecoveryAction(RecoveryActionType.ResetState, "Reset object state"),
                new RecoveryAction(RecoveryActionType.NotifyAdmin, "Alert on null reference")
            });
            recoveryMap.Add("TimeoutException", new List<RecoveryAction>
            {
                new RecoveryAction(RecoveryActionType.RestartService, "Restart timed-out service"),
                new RecoveryAction(RecoveryActionType.FallbackToDefault, "Use default response")
            });
        }

        public List<RecoveryAction> GetActions(string errorType)
        {
            if (recoveryMap.ContainsKey(errorType))
            {
                return recoveryMap[errorType];
            }
            return new List<RecoveryAction>();
        }
    }

    // Monitors system health and triggers error detection
    class HealthMonitor
    {
        public bool IsHealthy { get; private set; }
        public List<ErrorEvent> DetectedErrors { get; private set; }

        public HealthMonitor()
        {
            IsHealthy = true;
            DetectedErrors = new List<ErrorEvent>();
        }

        // Simulate health check
        public void PerformHealthCheck()
        {
            // In a real system, this would check actual system metrics
            // For demonstration, we'll randomly detect an error
            if (System.Random.Shared.Next(0, 2) == 0)
            {
                IsHealthy = false;
                DetectedErrors.Add(new ErrorEvent("TimeoutException", "Service timeout detected"));
            }
            else
            {
                IsHealthy = true;
            }
        }
    }

    // Orchestrates the self-healing process
    class SelfHealingController
    {
        private HealthMonitor healthMonitor;
        private ErrorRecoveryMap recoveryMap;

        public SelfHealingController()
        {
            healthMonitor = new HealthMonitor();
            recoveryMap = new ErrorRecoveryMap();
        }

        // Main method to handle healing
        public void ExecuteHealingCycle()
        {
            Console.WriteLine("Starting healing cycle...");
            healthMonitor.PerformHealthCheck();

            if (!healthMonitor.IsHealthy)
            {
                foreach (var error in healthMonitor.DetectedErrors)
                {
                    Console.WriteLine($"Detected error: {error.ErrorType} - {error.Description}");
                    List<RecoveryAction> actions = recoveryMap.GetActions(error.ErrorType);
                    foreach (var action in actions)
                    {
                        action.Execute();
                    }
                }
                // Reset error list for next cycle
                healthMonitor.DetectedErrors.Clear();
                healthMonitor.IsHealthy = true;
            }
            else
            {
                Console.WriteLine("System is healthy.");
            }
            Console.WriteLine("Healing cycle complete.\n");
        }
    }

    // Entry point for the self-healing tool
    class Program
    {
        static void Main(string[] args)
        {
            SelfHealingController controller = new SelfHealingController();
            for (int i = 0; i < 5; i++)
            {
                controller.ExecuteHealingCycle();
            }
        }
    }
}
