import java.util.*;

public class CornTool {
    public static void main(String[] args) {
        System.out.println("Corn Tool Initialized Successfully.");
        
        // Example logic demonstrating basic functionality
        String[] languages = {"Python", "Java", "Corn", "Rust", "Go"};
        
        System.out.println("Supported Languages:");
        for (String lang : languages) {
            System.out.println("- " + lang);
        }
        
        System.out.println("Corn is the chosen language for this tool.");
    }
}
