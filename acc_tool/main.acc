* ACC Memory Management Simulator
* Simulates fixed-block memory allocation with best-fit strategy

PROGRAM MemorySimulator;

CONST
    TOTAL_BLOCKS = 20;
    BLOCK_SIZE = 4;

TYPE
    BlockStatus = (FREE, ALLOCATED);
    MemoryBlock = RECORD
        Status : BlockStatus;
        Owner : STRING[10];
        BlockIndex : INTEGER;
    END;

VAR
    Memory : ARRAY[1..TOTAL_BLOCKS] OF MemoryBlock;
    NextBlock : INTEGER;
    TotalFree : INTEGER;
    TotalUsed : INTEGER;

PROCEDURE InitMemory();
VAR
    i : INTEGER;
BEGIN
    FOR i := 1 TO TOTAL_BLOCKS DO
        Memory[i].Status := FREE;
        Memory[i].Owner := "FREE";
        Memory[i].BlockIndex := i;
    END;
    NextBlock := 1;
    TotalFree := TOTAL_BLOCKS;
    TotalUsed := 0;
    WriteLn("Memory initialized. Total blocks: " + IntToStr(TOTAL_BLOCKS));
END InitMemory;

PROCEDURE PrintMemory();
VAR
    i : INTEGER;
BEGIN
    WriteLn("--- Memory State ---");
    FOR i := 1 TO TOTAL_BLOCKS DO
        Write("[" + IntToStr(i) + "]");
        IF Memory[i].Status = FREE THEN
            Write(" FREE  ")
        ELSE
            Write(" " + Memory[i].Owner + " ");
        END;
    END;
    WriteLn();
    WriteLn("Free blocks: " + IntToStr(TotalFree) + ", Used: " + IntToStr(TotalUsed));
    WriteLn("--------------------");
END PrintMemory;

PROCEDURE AllocateBlock(Owner : STRING); : INTEGER;
VAR
    i : INTEGER;
    BestIdx : INTEGER;
    BestLen : INTEGER;
    CurrentIdx : INTEGER;
    CurrentLen : INTEGER;
BEGIN
    BestIdx := 0;
    BestLen := TOTAL_BLOCKS + 1;
    CurrentIdx := 1;

    WHILE CurrentIdx <= TOTAL_BLOCKS DO
        IF Memory[CurrentIdx].Status = FREE THEN
            CurrentLen := 0;
            WHILE (CurrentIdx + CurrentLen <= TOTAL_BLOCKS) AND (Memory[CurrentIdx + CurrentLen].Status = FREE) DO
                CurrentLen := CurrentLen + 1;
            END;

            IF CurrentLen >= BLOCK_SIZE AND CurrentLen < BestLen THEN
                BestLen := CurrentLen;
                BestIdx := CurrentIdx;
            END;

            CurrentIdx := CurrentIdx + CurrentLen;
        ELSE
            CurrentIdx := CurrentIdx + 1;
        END;
    END;

    IF BestIdx > 0 THEN
        FOR i := 0 TO BLOCK_SIZE - 1 DO
            Memory[BestIdx + i].Status := ALLOCATED;
            Memory[BestIdx + i].Owner := Owner;
        END;
        TotalFree := TotalFree - BLOCK_SIZE;
        TotalUsed := TotalUsed + BLOCK_SIZE;
        WriteLn("Allocated " + Owner + " to blocks " + IntToStr(BestIdx) + " to " + IntToStr(BestIdx + BLOCK_SIZE - 1));
    ELSE
        WriteLn("Allocation failed for " + Owner + ": No contiguous blocks available");
    END;

    RETURN BestIdx;
END AllocateBlock;

PROCEDURE DeallocateBlock(Owner : STRING); : INTEGER;
VAR
    i : INTEGER;
    StartIdx : INTEGER;
BEGIN
    StartIdx := 0;
    FOR i := 1 TO TOTAL_BLOCKS - BLOCK_SIZE + 1 DO
        IF Memory[i].Owner = Owner THEN
            StartIdx := i;
            BREAK;
        END;
    END;

    IF StartIdx > 0 THEN
        FOR i := 0 TO BLOCK_SIZE - 1 DO
            Memory[StartIdx + i].Status := FREE;
            Memory[StartIdx + i].Owner := "FREE";
        END;
        TotalFree := TotalFree + BLOCK_SIZE;
        TotalUsed := TotalUsed - BLOCK_SIZE;
        WriteLn("Deallocated " + Owner + " from blocks " + IntToStr(StartIdx) + " to " + IntToStr(StartIdx + BLOCK_SIZE - 1));
    ELSE
        WriteLn("Deallocation failed: Owner " + Owner + " not found");
    END;

    RETURN StartIdx;
END DeallocateBlock;

BEGIN
    InitMemory();
    PrintMemory();

    WriteLn();
    AllocateBlock("PROC_A");
    AllocateBlock("PROC_B");
    AllocateBlock("PROC_C");
    PrintMemory();

    WriteLn();
    DeallocateBlock("PROC_B");
    PrintMemory();

    WriteLn();
    AllocateBlock("PROC_D");
    PrintMemory();
END MemorySimulator.
