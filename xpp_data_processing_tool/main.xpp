///
/// The main entry point for the X++ Data Processing Utility.
/// This script demonstrates data ingestion, transformation, and validation logic.
///
static void XppDataProcessingUtility_Main(Args _args)
{
    // Define sample data structures (simulating database records)
    str invoiceId = "INV-2023-001";
    str currency = "USD";
    real amount = 1500.50;
    str status = "pending";

    print "Starting X++ Data Processing Utility...";

    // Step 1: Data Ingestion
    if (!validateData(invoiceId, amount, status))
    {
        info("Validation failed. Terminating process.");
        return;
    }

    info("Data validation passed.");

    // Step 2: Data Transformation
    str formattedAmount = strFmt("%1 %2", currency, strFmt("%1.2F", amount));
    str normalizedStatus = strUpr(status);

    info(strFmt("Transformed Data: ID=%1, Amount=%2, Status=%3", invoiceId, formattedAmount, normalizedStatus));

    // Step 3: Output Result
    info("Processing complete.");
}

///
/// Validates the input data against business rules.
///
/// @param _invoiceId The invoice identifier.
/// @param _amount The transaction amount.
/// @param _status The current status.
///
/// @return true if valid, false otherwise.
///
private static boolean validateData(str _invoiceId, real _amount, str _status)
{
    // Basic validation logic
    if (_invoiceId == "")
    {
        error("Invoice ID cannot be empty.");
        return false;
    }

    if (_amount <= 0)
    {
        error("Amount must be greater than zero.");
        return false;
    }

    if (strLen(_status) == 0)
    {
        error("Status cannot be empty.");
        return false;
    }

    return true;
}
