// LINC Tool - Text Parsing and String Manipulation Utility

// Import standard libraries
IMPORT std/io;
IMPORT std/text;
IMPORT std/math;

// Define constants
CONST MAX_STRING_LENGTH = 1024;
CONST BUFFER_SIZE = 512;

// Global variables
VAR input_text : TEXT;
VAR output_text : TEXT;
VAR is_processing : BOOL = FALSE;

// Function to initialize the tool
FUNCTION Initialize() -> BOOL {
    PRINT "LINC Tool Initialized.\n";
    PRINT "Ready for text processing.\n";
    RETURN TRUE;
}

// Function to read input from user
FUNCTION ReadInput() -> TEXT {
    VAR prompt : TEXT = "Enter text to process: ";
    PRINT prompt;
    VAR input : TEXT;
    READ input;
    RETURN input;
}

// Function to process text
FUNCTION ProcessText(input : TEXT) -> TEXT {
    VAR result : TEXT = "";
    VAR words : ARRAY OF TEXT;
    
    // Split input into words
    words = TEXT.Split(input, " ");
    
    // Process each word
    FOR EACH word IN words {
        // Reverse the word
        VAR reversed : TEXT = TEXT.Reverse(word);
        // Convert to uppercase
        result = result + TEXT.Upper(reversed) + " ";
    }
    
    // Remove trailing space
    IF result.Length > 0 {
        result = result.Substr(0, result.Length - 1);
    }
    
    RETURN result;
}

// Function to write output to user
FUNCTION WriteOutput(output : TEXT) {
    PRINT "Processed text: ";
    PRINT output;
}

// Main function
FUNCTION Main() {
    // Initialize the tool
    IF !Initialize() {
        PRINT "Failed to initialize the tool.\n";
        RETURN;
    }
    
    // Start processing loop
    WHILE TRUE {
        // Read input
        VAR input = ReadInput();
        
        // Check for exit command
        IF input == "exit" || input == "quit" {
            PRINT "Exiting LINC Tool.\n";
            BREAK;
        }
        
        // Process text
        output_text = ProcessText(input);
        
        // Write output
        WriteOutput(output_text);
        
        // Add a separator
        PRINT "\n";
    }
}

// Run the main function
Main();
