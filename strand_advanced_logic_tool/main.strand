// Strand Advanced Logic Tool - Main Implementation
// Purpose: Symbolic Computation and State Management

// Define the Symbolic Expression type
enum Expr {
    Number(n: Int),
    Variable(name: String),
    Add(left: Expr, right: Expr),
    Sub(left: Expr, right: Expr),
    Mul(left: Expr, right: Expr),
    Div(left: Expr, right: Expr)
}

// State Monad for managing state in a functional way
type State<S, A> = (S -> (A, S))

// Pure evaluation function for symbolic expressions
def evaluate(expr: Expr, vars: Map<String, Int>) -> Int {
    match expr {
        case Number(n):
            return n
        case Variable(name):
            return Map.get(vars, name, 0)
        case Add(left, right):
            return evaluate(left, vars) + evaluate(right, vars)
        case Sub(left, right):
            return evaluate(left, vars) - evaluate(right, vars)
        case Mul(left, right):
            return evaluate(left, vars) * evaluate(right, vars)
        case Div(left, right):
            val d = evaluate(right, vars)
            if d == 0 {
                return 0 // Handle division by zero
            }
            return evaluate(left, vars) / d
    }
}

// Simple symbolic differentiation
// d/dx (x) = 1, d/dx (c) = 0, d/dx (f+g) = f' + g', etc.
def differentiate(expr: Expr, variable: String) -> Expr {
    match expr {
        case Number(_):
            return Number(0)
        case Variable(v):
            if v == variable {
                return Number(1)
            } else {
                return Number(0)
            }
        case Add(left, right):
            return Add(differentiate(left, variable), differentiate(right, variable))
        case Sub(left, right):
            return Sub(differentiate(left, variable), differentiate(right, variable))
        case Mul(left, right):
            // Product rule: f'g + fg'
            return Add(Mul(differentiate(left, variable), right), Mul(left, differentiate(right, variable)))
        case Div(left, right):
            // Quotient rule: (f'g - fg') / g^2
            return Div(
                Sub(Mul(differentiate(left, variable), right), Mul(left, differentiate(right, variable))),
                Mul(right, right)
            )
    }
}

// Main entry point
def main():
    // Initialize variables map
    vars = Map("x" -> 5, "y" -> 3)
    
    // Create an expression: x^2 + y
    // Represented as Add(Mul(Variable("x"), Variable("x")), Variable("y"))
    expr = Add(Mul(Variable("x"), Variable("x")), Variable("y"))
    
    // Evaluate
    val = evaluate(expr, vars)
    log("Evaluation of x^2 + y with x=5, y=3: " + String(val))
    
    // Differentiate with respect to x
    deriv = differentiate(expr, "x")
    log("Derivative with respect to x: " + toString(deriv))
    
    // Evaluate derivative: 2x + 0 -> 2*5 = 10
    valDeriv = evaluate(deriv, vars)
    log("Derivative value: " + String(valDeriv))

// Helper to convert Expr to string (simplified)
def toString(expr: Expr) -> String {
    match expr {
        case Number(n):
            return String(n)
        case Variable(name):
            return name
        case Add(left, right):
            return "(" + toString(left) + " + " + toString(right) + ")"
        case Sub(left, right):
            return "(" + toString(left) + " - " + toString(right) + ")"
        case Mul(left, right):
            return "(" + toString(left) + " * " + toString(right) + ")"
        case Div(left, right):
            return "(" + toString(left) + " / " + toString(right) + ")"
    }
}
