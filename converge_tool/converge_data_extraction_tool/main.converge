import system.io
import system.text
import system.collections

def extract_data(input_text: String, pattern: String): List<String> {
  var results = new List<String>()
  var regex = new Regex(pattern)
  var match = regex.Match(input_text)
  while (match.Success) {
    results.Add(match.Value)
    match = match.NextMatch()
  }
  return results
}

def main() {
  var text = "Contact us at support@example.com or sales@example.org"
  var emails = extract_data(text, r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b")
  for email in emails {
    io.println(email)
  }
}
