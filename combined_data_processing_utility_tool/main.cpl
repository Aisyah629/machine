COMMENT THIS IS A COMBINED PROGRAMMING LANGUAGE (CPL) UTILITY FOR DATA PROCESSING;

DEFINE DATA_PROCESSING_UTILITY
  PROCEDURE MAIN
    DATA_RECORD INPUT_RECORD OUTPUT_RECORD
    STRING DATA_BUFFER
    BOOLEAN PROCESSING_LOOP

    INITIALIZE
      PROCESSING_LOOP := TRUE
      OUTPUT_RECORD = NULL

    WHILE PROCESSING_LOOP
      DISPLAY "Enter data to process (or 'quit' to exit):"
      READ DATA_BUFFER

      IF DATA_BUFFER == 'quit'
        PROCESSING_LOOP := FALSE
      ELSE
        OUTPUT_RECORD = TRANSFORM_DATA(DATA_BUFFER)
        DISPLAY "Processed data: " OUTPUT_RECORD
      END IF
    END WHILE

    DISPLAY "Data processing complete."
  END PROCEDURE MAIN

  PROCEDURE TRANSFORM_DATA(IN_STRING)
    DATA RESULT_STRING
    DATA TEMP_VAR INTEGER

    COMMENT TRANSFORM INPUT STRING BY CONVERTING TO UPPERCASE AND REMOVING SPACES;
    TEMP_VAR = LENGTH(IN_STRING)
    RESULT_STRING = ""

    LOOP FROM 1 TO TEMP_VAR STEP 1
      CHARACTER CURRENT_CHAR
      CURRENT_CHAR = SUBSTRING(IN_STRING, @I, 1)
      IF CURRENT_CHAR != ' '
        RESULT_STRING = RESULT_STRING + UPPERCASE(CURRENT_CHAR)
      END IF
    END LOOP

    RETURN RESULT_STRING
  END PROCEDURE TRANSFORM_DATA

END DEFINE DATA_PROCESSING_UTILITY

CALL DATA_PROCESSING_UTILITY::MAIN
