COMMENT THIS PROGRAM PROVIDES A ROBUST ALGOL 58 UTILITY FOR DATA PROCESSING;
IT INCLUDES FUNCTIONS FOR DATA CLEANING, VALIDATION, AND TRANSPORTATION OF STRUCTURED INPUT DATA;
AUTHOR: AUTOGENERATED AI POLYGLOT ENGINE;
DATE: 2023;

BEGIN
    COMMENT DEFINE CONSTANTS AND DATA STRUCTURES;
    INTEGER ARRAY SIZE (100);
    BOOLEAN ARRAY IS_VALID (100);
    REAL ARRAY VALUES (100);

    COMMENT PROCESS INPUT DATA STREAM;
    PROCEDURE PROCESS_DATA (STRING INPUT_STREAM);
    BEGIN
        INTEGER I;
        COMMENT PARSE AND VALIDATE EACH RECORD;
        FOR I := 1 STEP 1 UNTIL SIZE (100) DO
        BEGIN
            IF RECORD_EXISTS (INPUT_STREAM, I) THEN
            BEGIN
                VALUES (I) := PARSE_NUMERIC (INPUT_STREAM, I);
                IS_VALID (I) := CHECK_RANGE (VALUES (I), 0.0, 1000.0);
            END
            ELSE
                IS_VALID (I) := FALSE
        END;
        COMMENT OUTPUT CLEANED RESULTS;
        OUTPUT_RESULTS (VALUES, IS_VALID, SIZE);
    END;

    COMMENT CHECK IF A RECORD EXISTS IN THE STREAM;
    PROCEDURE RECORD_EXISTS (STRING STREAM, INTEGER INDEX);
    BEGIN
        RETURN INDEX <= LENGTH (STREAM) / RECORD_SIZE
    END;

    COMMENT PARSE NUMERIC VALUE FROM SPECIFIC RECORD;
    PROCEDURE PARSE_NUMERIC (STRING STREAM, INTEGER INDEX);
    BEGIN
        RETURN STRING_TO_REAL (SUBSTRING (STREAM, INDEX * RECORD_SIZE, FIELD_LENGTH))
    END;

    COMMENT VALIDATE IF VALUE IS WITHIN ACCEPTABLE RANGE;
    PROCEDURE CHECK_RANGE (REAL VALUE, REAL MIN, REAL MAX);
    BEGIN
        RETURN VALUE >= MIN AND VALUE <= MAX
    END;

    COMMENT OUTPUT CLEANED AND VALIDATED RESULTS;
    PROCEDURE OUTPUT_RESULTS (REAL ARRAY DATA, BOOLEAN ARRAY VALID, INTEGER ARRAY SIZE);
    BEGIN
        INTEGER I;
        FOR I := 1 STEP 1 UNTIL SIZE (100) DO
        BEGIN
            IF VALID (I) THEN
                PRINT ("VALID: " , DATA (I))
            ELSE
                PRINT ("INVALID: " , DATA (I))
        END
    END;

    COMMENT MAIN EXECUTION BLOCK;
    PROCESS_DATA (GET_INPUT_DATA ());
END
