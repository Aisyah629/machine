DEF DATA_PROCESSOR_TOOL
  ; KUKA Robot Language (KRL) Data Processing Utility
  ; Handles sensor data transformation and validation

  ; Global Variables for Data Processing
  GLOBAL REAL sensor_data[100]    ; Array to hold raw sensor data
  GLOBAL REAL processed_data[100]  ; Array to hold transformed data
  GLOBAL INT data_index = 0
  GLOBAL BOOL data_ready = FALSE
  GLOBAL REAL min_threshold = 0.0
  GLOBAL REAL max_threshold = 100.0

  ; Configuration
  DEF CONFIGURE_DATA_PROCESSOR()
    ; Set processing parameters
    min_threshold = 10.0
    max_threshold = 90.0
    data_index = 0
    data_ready = FALSE
    DATAPROC_LOG("Data Processor Initialized")
  END

  ; Function to ingest raw sensor data
  DEF INGEST_SENSOR_DATA(raw_value REAL)
    IF data_index < 100 THEN
      sensor_data[data_index] = raw_value
      data_index = data_index + 1
      DATAPROC_LOG("Ingested: " + STR(raw_value))
    ELSE
      DATAPROC_LOG("Error: Buffer Full")
    ENDIF
  END

  ; Function to transform data (e.g., normalization)
  DEF TRANSFORM_DATA()
    LOCAL INT i = 0
    LOCAL REAL normalized_value = 0.0
    
    ; Reset processed data
    FOR i = 0 TO 99
      processed_data[i] = 0.0
    ENDFOR

    ; Apply transformation logic
    FOR i = 0 TO data_index - 1
      IF sensor_data[i] >= min_threshold AND sensor_data[i] <= max_threshold THEN
        ; Normalize to 0-1 range
        normalized_value = (sensor_data[i] - min_threshold) / (max_threshold - min_threshold)
        processed_data[i] = normalized_value
      ELSE
        processed_data[i] = -1.0 ; Indicate out of bounds
      ENDIF
    ENDFOR
    
    data_ready = TRUE
    DATAPROC_LOG("Data Transformation Complete")
  END

  ; Function to validate processed data
  DEF VALIDATE_DATA() RETURN BOOL
    LOCAL INT i = 0
    LOCAL BOOL valid = TRUE
    
    FOR i = 0 TO data_index - 1
      IF processed_data[i] < 0.0 OR processed_data[i] > 1.0 THEN
        valid = FALSE
        DATAPROC_LOG("Validation Error at index: " + STR(i))
      ENDIF
    ENDFOR
    
    RETURN valid
  END

  ; Helper logging function
  DEF DATAPROC_LOG(message STRING)
    ; In a real KUKA system, this would write to a file or display
    ; For simulation, we just log conceptually
    SHOW_MESSAGE(message)
  END

  ; Main execution routine
  DEF MAIN()
    CONFIGURE_DATA_PROCESSOR()
    
    ; Simulate ingestion
    INGEST_SENSOR_DATA(50.0)
    INGEST_SENSOR_DATA(25.0)
    INGEST_SENSOR_DATA(150.0) ; Out of range
    
    ; Process data
    TRANSFORM_DATA()
    
    ; Validate
    IF VALIDATE_DATA() THEN
      DATAPROC_LOG("Data Validation Passed")
    ELSE
      DATAPROC_LOG("Data Validation Failed")
    ENDIF
  END

END
