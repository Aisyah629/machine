Class: Serializer
    Instance variables: dataStream
    
    open:
        dataStream := WriteStream on: (ByteArray new: 1024).
    
    serialize: anObject
        | serializedData |
        serializedData := self writeObject: anObject.
        ^ serializedData
    
    writeObject: anObject
        anObject isNil ifTrue: [^ #(Nil)].
        anObject isNumber ifTrue: [^ #(Number, anObject)].
        anObject isString ifTrue: [^ #(String, anObject)].
        anObject isCollection ifTrue: [
            | result |
            result := Array new.
            result at: 1 put: #(Collection).
            result at: 2 put: (anObject collect: [:each | self writeObject: each]).
            ^ result
        ].
        ^ #(Unknown, anObject).
    
    close:
        dataStream := nil.

Class: Deserializer
    
    deserialize: anArray
        | object |
        object := self readObject: anArray.
        ^ object
    
    readObject: anArray
        anArray size = 0 ifTrue: [^ nil].
        | type | type := anArray first.
        type = #Nil ifTrue: [^ nil].
        type = #Number ifTrue: [^ anArray second].
        type = #String ifTrue: [^ anArray second].
        type = #Collection ifTrue: [
            | collection |
            collection := OrderedCollection new.
            (anArray second) do: [:each | collection add: (self readObject: each)].
            ^ collection
        ].
        ^ anArray second.
