/* Cola Tool - Main Entry Point */

// Basic Cola interpreter structure
function main(args)
  // Check if a script file was provided
  if args.length == 0
    print "Usage: cola_tool <script.col>"
    return 1
  end

  // Read the script file
  let scriptFile = args[0]
  let scriptContent = readFile(scriptFile)

  if scriptContent == ""
    print "Error: Could not read script file or file not found: " + scriptFile
    return 1
  end

  // Initialize interpreter state
  let vm = new VirtualMachine()

  // Parse the script
  let program = parse(scriptContent)

  if program == null
    print "Error: Failed to parse script."
    return 1
  end

  // Execute the program
  try
    vm.execute(program)
  catch error
    print "Runtime Error: " + error.message
    return 1
  end

  return 0
end

