%% Sympl Advanced Data Processor
%% This file defines the core logic for the data processing tool.

%% Load necessary modules
IMPORT config.
IMPORT rules.
IMPORT data_engine.

%% Define the main processing function
PROCEDURE main(data)
    DECLARE config_file : STRING;
    DECLARE processed_data : LIST;
    DECLARE errors : LIST;

    %% Load configuration
    config_file = "config.json";
    IF NOT load_config(config_file, config)
        THEN
            PRINT "Error loading configuration file.";
            RETURN;
        END IF;

    %% Apply validation rules
    IF config.rules.validate_data
        THEN
            SET processed_data = validate(data, config.rules);
            IF NOT is_valid(processed_data)
                THEN
                    PRINT "Data validation failed.";
                    RETURN;
                END IF;
            END IF;

    %% Apply cleaning rules
    IF config.rules.clean_nulls
        THEN
            SET processed_data = clean_nulls(processed_data);
        END IF;

    %% Apply transformation rules
    IF config.rules.transform_types
        THEN
            SET processed_data = transform_types(processed_data, config.settings);
        END IF;

    %% Generate report
    SET report = generate_report(processed_data, errors);
    PRINT report;

    %% Save output
    IF save_output(processed_data, config.output)
        THEN
            PRINT "Data processing completed successfully.";
        ELSE
            PRINT "Error saving output.";
        END IF;

END PROCEDURE;

%% Helper function to validate data
FUNCTION validate(data, rules)
    DECLARE valid_data : LIST;
    DECLARE errors : LIST;

    FOR EACH record IN data
        DO
            IF check_record(record, rules)
                THEN
                    APPEND valid_data, record;
                ELSE
                    APPEND errors, record;
                END IF;
            END FOR;

    SET global_errors = errors;
    RETURN valid_data;
END FUNCTION;

%% Helper function to clean nulls
FUNCTION clean_nulls(data)
    DECLARE cleaned_data : LIST;

    FOR EACH record IN data
        DO
            SET cleaned_record = remove_nulls(record);
            APPEND cleaned_data, cleaned_record;
        END FOR;

    RETURN cleaned_data;
END FUNCTION;

%% Helper function to transform types
FUNCTION transform_types(data, settings)
    DECLARE transformed_data : LIST;

    FOR EACH record IN data
        DO
            SET transformed_record = apply_transformations(record, settings);
            APPEND transformed_data, transformed_record;
        END FOR;

    RETURN transformed_data;
END FUNCTION;

%% Helper function to generate report
FUNCTION generate_report(data, errors)
    DECLARE report : STRING;

    SET report = "Processing Report:\n";
    SET report = CONCAT(report, "Total Records Processed: " FORMAT LENGTH(data) "\n");
    SET report = CONCAT(report, "Errors Encountered: " FORMAT LENGTH(errors) "\n");
    RETURN report;
END FUNCTION;

%% Helper function to save output
FUNCTION save_output(data, output_config)
    DECLARE file_path : STRING;
    DECLARE success : BOOLEAN;

    SET file_path = output_config.destination;
    SET success = write_to_file(file_path, data);
    RETURN success;
END FUNCTION;

%% Entry point
main(input_data);
