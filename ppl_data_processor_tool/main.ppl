// PPL Data Processing Utility
// This script processes data

PROC main()
  // Input data
  DATA input_data = {1, 2, 3, 4, 5}
  
  // Process data
  DATA result
  result = []
  FOR item IN input_data DO
    item = item * 2
    APPEND result, item
  END
  
  // Output result
  PRINT "Processed data: " + result
END
