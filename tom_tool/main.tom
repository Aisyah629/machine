template WebPage {
    header {
        title "Welcome to My Web App"
        nav {
            link href="/about" "About"
            link href="/contact" "Contact"
        }
    }
    body {
        section id="main" {
            h1 "Main Content"
            p "This is the main content of the page."
        }
    }
    footer {
        p "Copyright 2023 My Web App"
    }
}

transform WebPage to HTML {
    output file="index.html"
}
