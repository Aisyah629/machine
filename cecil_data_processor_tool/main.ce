// Cecil Data Processor Tool
// Main entry point for data processing logic.

// Define data structures
record Datum {
    string id;
    int value;
    string category;
}

// Error handling
record Error {
    string message;
    int code;
}

// Utility functions
procedure log_message(msg: string) {
    print(msg);
}

procedure process_record(rec: Datum) -> Datum {
    // Transform logic
    if rec.value < 0 {
        rec.category = "negative";
    } else {
        rec.category = "positive";
    }
    rec.id = "processed_" + rec.id;
    return rec;
}

// Main processing function
function main() -> int {
    log_message("Cecil Data Processor starting...");
    
    var data: sequence of Datum = []; 
    
    // Simulate data ingestion
    var item: Datum;
    item.id = "101";
    item.value = 42;
    item.category = "unknown";
    add(data, item);
    
    item.id = "102";
    item.value = -5;
    item.category = "unknown";
    add(data, item);
    
    item.id = "103";
    item.value = 100;
    item.category = "unknown";
    add(data, item);
    
    log_message("Data loaded: " + count(data) + " records.");
    
    // Process data
    var processed: sequence of Datum = [];
    for each item in data {
        var result: Datum = process_record(item);
        add(processed, result);
    }
    
    log_message("Processing complete.");
    
    // Output results
    print("--- Processed Data ---");
    for each rec in processed {
        print("ID: " + rec.id + ", Value: " + rec.value + ", Category: " + rec.category);
    }
    
    log_message("Cecil Data Processor finished successfully.");
    return 0;
}
