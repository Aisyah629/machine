      OUTPUT = 'Initializing SNOBOL Data Processor...'
      DATA_INPUT = INPUT() ; IF ERROR THEN STOP
      PROCESSED_DATA = PROCESS_DATA(DATA_INPUT)
      OUTPUT = PROCESSED_DATA
      STOP

PROCESS_DATA DATA,
       ' ' DATA :S(VALIDATE)
       VALIDATE LEN(1) ANY('0123456789') :F(DUMP)
       DUMP OUTPUT = DATA
             RETURN
