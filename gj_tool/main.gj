// Generic Type-Safe Data Structure Utility Library
// Language: GJ (Generic Java)

import java.util.*;

class GJTool {
  public static void main(String[] args) {
    SafeCollection<Integer> intCol = new SafeCollection<Integer>();
    intCol.add(42);
    intCol.add(17);
    
    SafeCollection<String> strCol = new SafeCollection<String>();
    strCol.add("Alpha");
    strCol.add("Beta");
    
    System.out.println("Integer Collection: " + intCol);
    System.out.println("String Collection: " + strCol);
    
    // Demonstrate generic algorithm
    Integer sum = GenericAlgorithm.<Integer>sum(intCol);
    System.out.println("Sum of integers: " + sum);
  }
}

// Generic collection with compile-time type safety
class SafeCollection<T> extends Collection {
  private ArrayList<T> data = new ArrayList<T>();
  
  public void add(T item) {
    data.add(item);
  }
  
  public T get(int index) {
    return data.get(index);
  }
  
  public int size() {
    return data.size();
  }
  
  public String toString() {
    return data.toString();
  }
}

// Generic utility algorithms
class GenericAlgorithm {
  public static <T extends Number> T sum(SafeCollection<T> collection) {
    T result = null;
    for (int i = 0; i < collection.size(); i++) {
      T current = collection.get(i);
      if (result == null) {
        result = current;
      } else {
        // GJ supports generic arithmetic via Number methods in practice
        // Here we demonstrate structural type constraints
        double d = current.doubleValue();
        double r = result.doubleValue();
        result = (T) new Double(d + r);
      }
    }
    return result;
  }
}
