; ============================================================
; Hamilton C Shell - Low-Level Memory Management Simulator
; ============================================================
; This script simulates a simplified heap-based memory allocator.
; It demonstrates manual allocation, deallocation, and fragmentation.
; ============================================================

$heap_start = 1000
$heap_end = 2000
$heap_size = $heap_end - $heap_start
$free_blocks = [[1000, 100]]
$used_blocks = []

; Initialize heap with a single free block
print("Initializing memory pool at $heap_start...")
print("Heap size: $heap_size bytes")
print("Initial state: Free")

; Function to allocate memory
function alloc_block(size)
    $i = 0
    loop
        if $i >= count($free_blocks)
            print("Allocation failed: Out of memory")
            return -1
        end
        $block = $free_blocks[$i]
        if $block[1] >= $size
            $alloc_start = $block[0]
            $alloc_size = $size
            $new_free_start = $block[0] + $size
            $new_free_size = $block[1] - $size
            
            ; Remove old free block
            remove_from($free_blocks, $i)
            
            ; Add allocated block
            add_to($used_blocks, [$alloc_start, $alloc_size])
            print("Allocated $alloc_size bytes at address $alloc_start")
            
            ; If there is leftover space, add it back to free list
            if $new_free_size > 0
                add_to($free_blocks, [$new_free_start, $new_free_size])
                print("Leftover $new_free_size bytes added to free pool")
            end
            
            return $alloc_start
        end
        $i = $i + 1
    end
end

; Function to free memory
function free_block(address)
    $i = 0
    loop
        if $i >= count($used_blocks)
            print("Free failed: Invalid address $address")
            return 0
        end
        $block = $used_blocks[$i]
        if $block[0] == $address
            $size = $block[1]
            remove_from($used_blocks, $i)
            print("Freed $size bytes from address $address")
            
            ; Add back to free list
            add_to($free_blocks, [$address, $size])
            
            ; Merge adjacent free blocks (simplified)
            sort_by($free_blocks, 0)
            merge_adjacent($free_blocks)
            
            return 1
        end
        $i = $i + 1
    end
end

; Function to display heap state
function print_heap()
    print("=== Heap State ===")
    print("Free Blocks:")
    $i = 0
    loop
        if $i >= count($free_blocks)
            break
        end
        print("  [$free_blocks[$i][0]]: $free_blocks[$i][1] bytes")
        $i = $i + 1
    end
    print("Used Blocks:")
    $i = 0
    loop
        if $i >= count($used_blocks)
            break
        end
        print("  [$used_blocks[$i][0]]: $used_blocks[$i][1] bytes")
        $i = $i + 1
    end
    print("==================")
end

; Helper functions
function remove_from(arr, index)
    $result = []
    $i = 0
    loop
        if $i == index
            $i = $i + 1
            continue
        end
        if $i >= count(arr)
            break
        end
        add_to($result, arr[$i])
        $i = $i + 1
    end
    return $result
end

function add_to(arr, element)
    arr = arr + [element]
    return arr
end

function sort_by(arr, key)
    ; Simple bubble sort for demonstration
    $n = count(arr)
    $i = 0
    loop
        if $i >= $n
            break
        end
        $j = 0
        loop
            if $j >= $n - 1
                break
            end
            if arr[$j][key] > arr[$j + 1][key]
                $temp = arr[$j]
                arr[$j] = arr[$j + 1]
                arr[$j + 1] = $temp
            end
            $j = $j + 1
        end
        $i = $i + 1
    end
    return arr
end

function merge_adjacent(arr)
    $i = 0
    loop
        if $i >= count(arr) - 1
            break
        end
        $current = arr[$i]
        $next = arr[$i + 1]
        if $current[0] + $current[1] == $next[0]
            ; Merge current and next
            $current[1] = $current[1] + $next[1]
            remove_from(arr, $i + 1)
            arr[$i] = $current
        end
        $i = $i + 1
    end
    return arr
end

; Main execution flow
print("Running Memory Simulation...")

; Allocate some blocks
$addr1 = alloc_block(50)
$addr2 = alloc_block(100)
$addr3 = alloc_block(25)

print_heap()

; Free a block
free_block($addr2)
print_heap()

; Allocate again to show fragmentation
$addr4 = alloc_block(60)
print_heap()

; Free all and finalize
free_block($addr1)
free_block($addr3)
free_block($addr4)
print("Simulation complete.")
