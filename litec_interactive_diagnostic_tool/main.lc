// Lite-C Interactive Diagnostic and Visualization Tool
// This script provides a real-time diagnostic dashboard for system metrics.

#include <std.lh>
#include <canvas.lh>
#include <gui.lh>

// Global Variables for System State
int g_cpu_usage = 0;
int g_memory_usage = 0;
int g_network_traffic = 0;
int g_is_monitoring = 0;
int g_anomaly_detected = 0;

// UI Elements
int start_button;
int stop_button;
int reset_button;

// Visualization Canvas
int canvas_width = 640;
int canvas_height = 480;

// Function Prototypes
void init_diagnostics();
void monitor_system();
void detect_anomalies();
void render_dashboard();
void handle_input();
void reset_diagnostics();

// Main Entry Point
void main()
{
    // Initialize the graphics engine
    init_graphics(canvas_width, canvas_height, "Lite-C Diagnostic Dashboard");
    set_frame_rate(60);
    
    // Initialize diagnostic system
    init_diagnostics();
    
    // Create UI elements
    create_button("Start", 50, 400, 100, 50, &start_button);
    create_button("Stop", 250, 400, 100, 50, &stop_button);
    create_button("Reset", 450, 400, 100, 50, &reset_button);
    
    // Main Loop
    while (!key_pressed(KEY_ESC))
    {
        handle_input();
        if (g_is_monitoring)
        {
            monitor_system();
            detect_anomalies();
        }
        render_dashboard();
        update_display();
    }
    
    // Cleanup
    destroy_graphics();
}

// Initialize Diagnostic System
void init_diagnostics()
{
    g_cpu_usage = 0;
    g_memory_usage = 0;
    g_network_traffic = 0;
    g_is_monitoring = 0;
    g_anomaly_detected = 0;
    clear_canvas();
}

// Monitor System Metrics
void monitor_system()
{
    // Simulate system metrics
    g_cpu_usage = random(20, 90);
    g_memory_usage = random(30, 80);
    g_network_traffic = random(10, 100);
}

// Detect Anomalies
void detect_anomalies()
{
    if (g_cpu_usage > 80 || g_memory_usage > 70)
    {
        g_anomaly_detected = 1;
    }
    else
    {
        g_anomaly_detected = 0;
    }
}

// Render Dashboard
void render_dashboard()
{
    clear_canvas();
    
    // Draw Background
    set_color(COLOR_WHITE);
    fill_rectangle(0, 0, canvas_width, canvas_height);
    
    // Draw Title
    set_color(COLOR_BLACK);
    draw_text(10, 10, "System Diagnostic Dashboard");
    
    // Draw CPU Usage
    set_color(COLOR_BLACK);
    draw_text(10, 50, "CPU Usage:");
    set_color(COLOR_BLUE);
    fill_rectangle(10, 70, g_cpu_usage * 5, 20);
    set_color(COLOR_BLACK);
    draw_text(10, 90, g_cpu_usage + "%");
    
    // Draw Memory Usage
    set_color(COLOR_BLACK);
    draw_text(10, 120, "Memory Usage:");
    set_color(COLOR_GREEN);
    fill_rectangle(10, 140, g_memory_usage * 5, 20);
    set_color(COLOR_BLACK);
    draw_text(10, 160, g_memory_usage + "%");
    
    // Draw Network Traffic
    set_color(COLOR_BLACK);
    draw_text(10, 190, "Network Traffic:");
    set_color(COLOR_ORANGE);
    fill_rectangle(10, 210, g_network_traffic * 5, 20);
    set_color(COLOR_BLACK);
    draw_text(10, 230, g_network_traffic + " MB/s");
    
    // Draw Anomaly Warning
    if (g_anomaly_detected)
    {
        set_color(COLOR_RED);
        draw_text(10, 260, "WARNING: ANOMALY DETECTED!");
    }
    
    // Draw Status
    set_color(COLOR_BLACK);
    draw_text(10, 300, "Monitoring: " + (g_is_monitoring ? "Active" : "Inactive"));
    
    // Draw Buttons
    render_button(start_button);
    render_button(stop_button);
    render_button(reset_button);
}

// Handle Input
void handle_input()
{
    if (is_button_pressed(start_button))
    {
        g_is_monitoring = 1;
    }
    
    if (is_button_pressed(stop_button))
    {
        g_is_monitoring = 0;
    }
    
    if (is_button_pressed(reset_button))
    {
        reset_diagnostics();
    }
}

// Reset Diagnostics
void reset_diagnostics()
{
    init_diagnostics();
    g_is_monitoring = 0;
}
