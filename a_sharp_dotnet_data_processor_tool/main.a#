// A# .NET Data Processor Tool
// Main entry point for data processing utilities

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

namespace ASharpDataProcessor
{
    public class Program
    {
        public static async Task Main(string[] args)
        {
            Console.WriteLine("Initializing A# .NET Data Processor Tool...");

            // Example data source
            var rawData = new List<Dictionary<string, object>>
            {
                new Dictionary<string, object> { ["id"] = 1, ["value"] = 10, ["category"] = "A" },
                new Dictionary<string, object> { ["id"] = 2, ["value"] = 20, ["category"] = "B" },
                new Dictionary<string, object> { ["id"] = 3, ["value"] = 15, ["category"] = "A" },
                new Dictionary<string, object> { ["id"] = 4, ["value"] = 25, ["category"] = "B" }
            };

            try
            {
                var processor = new DataProcessor();
                var processedData = await processor.ProcessAsync(rawData);

                Console.WriteLine("Processing Complete.");
                Console.WriteLine($"Records processed: {processedData.Count}");

                foreach (var record in processedData)
                {
                    Console.WriteLine($"ID: {record["id"]}, Value: {record["value"]}, Category: {record["category"]}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error during processing: {ex.Message}");
            }

            Console.WriteLine("Data Processor Tool Finished.");
        }
    }

    public class DataProcessor
    {
        public Task<List<Dictionary<string, object>>> ProcessAsync(List<Dictionary<string, object>> data)
        {
            // Simulate async processing
            return Task.Run(() =>
            {
                var result = new List<Dictionary<string, object>>();

                foreach (var item in data)
                {
                    if (item.ContainsKey("value") && item["value"] is int val)
                    {
                        // Transform: Multiply value by 2
                        var transformedItem = new Dictionary<string, object>(item);
                        transformedItem["value"] = val * 2;
                        result.Add(transformedItem);
                    }
                }

                return result;
            });
        }
    }
}
