// EASYTRIEVE PLUS MAIN PROGRAM
// PURPOSE: Comprehensive mainframe data processing utility for high-throughput record manipulation

* DEFINE INPUT FILES
INPUT-FILE1 FILE INPUT-REC1
INPUT-FILE2 FILE INPUT-REC2

* DEFINE OUTPUT FILES
OUTPUT-FILE1 FILE OUTPUT-REC1
REPORT-FILE1 FILE REPORT-REC1

* DEFINE RECORDS
RECORD INPUT-REC1
  FIELD1 1-10 ALPHA
  FIELD2 11-20 NUMERIC
  FIELD3 21-30 ALPHA
END-RECORD

RECORD INPUT-REC2
  FIELD4 1-10 ALPHA
  FIELD5 11-20 NUMERIC
  FIELD6 21-30 ALPHA
END-RECORD

RECORD OUTPUT-REC1
  OUT-FIELD1 1-10 ALPHA
  OUT-FIELD2 11-20 NUMERIC
  OUT-FIELD3 21-30 ALPHA
  OUT-FIELD4 31-40 NUMERIC
END-RECORD

RECORD REPORT-REC1
  REPORT-LINE 1-80 ALPHA
END-RECORD

* DEFINE SORT AND JOIN WORKING STORAGE
WORKING-STORAGE
  WS-COUNTER 1-10 NUMERIC
  WS-TOTAL-FIELD2 11-20 NUMERIC
END-WORKING-STORAGE

* INITIALIZE
INITIALIZE INPUT-FILE1 INPUT-FILE2

* READ INPUT RECORDS
READ INPUT-FILE1
READ INPUT-FILE2

* PROCESS RECORDS
PERFORM PROCESS-RECORD UNTIL INPUT-FILE1.END-OF-FILE AND INPUT-FILE2.END-OF-FILE

* WRITE OUTPUT
IF INPUT-FILE1.FIELDS MATCH INPUT-FILE2.FIELDS
  WRITE OUTPUT-FILE1 FROM INPUT-FILE1
  WRITE OUTPUT-FILE1 FROM INPUT-FILE2
END-IF

* GENERATE REPORT
PERFORM GENERATE-REPORT

* FINALIZE
STOP RUN

PROCESS-RECORD
  ADD INPUT-REC2.FIELD5 TO OUTPUT-REC1.OUT-FIELD4
  ADD INPUT-REC1.FIELD2 TO OUTPUT-REC1.OUT-FIELD2
  MOVE INPUT-REC1.FIELD1 TO OUTPUT-REC1.OUT-FIELD1
  MOVE INPUT-REC1.FIELD3 TO OUTPUT-REC1.OUT-FIELD3
  MOVE INPUT-REC2.FIELD4 TO OUTPUT-REC1.OUT-FIELD1
  READ INPUT-FILE1
  READ INPUT-FILE2
END-PROCESS-RECORD

GENERATE-REPORT
  INITIALIZE REPORT-REC1
  MOVE 'HIGH-THROUGHPUT RECORD MANIPULATION REPORT' TO REPORT-LINE
  WRITE REPORT-FILE1 FROM REPORT-REC1
  MOVE 'PROCESSING COMPLETE' TO REPORT-LINE
  WRITE REPORT-FILE1 FROM REPORT-REC1
  STOP RUN
END-GENERATE-REPORT
