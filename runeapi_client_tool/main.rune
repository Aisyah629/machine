/* RuneScript High-Level Script Engine for API Interaction */
import 'net/http';
import 'io/log';
import 'utils/json';
import 'utils/retry';

/* Configuration Constants */
default_timeout = 30000;
default_max_retries = 3;
default_backoff_base = 1000;

/* API Client Configuration */
class ApiClient {
    private baseUrl;
    private authToken;
    private logger;

    public ApiClient(baseUrl, authToken) {
        this.baseUrl = baseUrl;
        this.authToken = authToken;
        this.logger = new Logger('ApiClient');
    }

    /* Makes an asynchronous HTTP request */
    async function makeRequest(method, endpoint, data, options) {
        let url = this.baseUrl + endpoint;
        let headers = this.buildHeaders(options);
        let body = this.serializeBody(data);
        let response;

        try {
            response = await http.request({
                method: method,
                url: url,
                headers: headers,
                body: body,
                timeout: options.timeout || default_timeout
            });

            return this.processResponse(response);
        } catch (error) {
            this.logger.error('Request failed: ' + error.message);
            throw error;
        }
    }

    /* Builds HTTP headers including authentication */
    private function buildHeaders(options) {
        let headers = {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
        };

        if (this.authToken) {
            headers['Authorization'] = 'Bearer ' + this.authToken;
        }

        if (options && options.headers) {
            headers = Object.assign(headers, options.headers);
        }

        return headers;
    }

    /* Serializes request body if necessary */
    private function serializeBody(data) {
        if (data === null || data === undefined) {
            return null;
        }
        if (typeof data === 'string') {
            return data;
        }
        return JSON.stringify(data);
    }

    /* Processes HTTP response and handles errors */
    private function processResponse(response) {
        if (response.status >= 200 && response.status < 300) {
            return {
                status: response.status,
                body: JSON.parse(response.body),
                headers: response.headers
            };
        } else {
            return {
                status: response.status,
                error: 'API Error',
                body: response.body
            };
        }
    }

    /* Public interface for GET requests */
    public function get(endpoint, options) {
        return this.makeRequest('GET', endpoint, null, options);
    }

    /* Public interface for POST requests */
    public function post(endpoint, data, options) {
        return this.makeRequest('POST', endpoint, data, options);
    }

    /* Public interface for PUT requests */
    public function put(endpoint, data, options) {
        return this.makeRequest('PUT', endpoint, data, options);
    }

    /* Public interface for DELETE requests */
    public function delete(endpoint, options) {
        return this.makeRequest('DELETE', endpoint, null, options);
    }
}

/* Retry Wrapper for API Calls */
class RetryableRequest {
    public static async execute(client, method, endpoint, data, maxRetries, backoffBase) {
        let attempt = 0;
        let lastError = null;

        while (attempt < maxRetries) {
            try {
                let requestFn = method === 'GET' ? client.get : (method === 'POST' ? client.post : client.delete);
                return await requestFn(endpoint, data);
            } catch (error) {
                lastError = error;
                attempt++;
                if (attempt < maxRetries) {
                    let delay = backoffBase * Math.pow(2, attempt - 1);
                    log.info('Retrying in ' + delay + 'ms...');
                    await this.sleep(delay);
                }
            }
        }

        throw lastError;
    }

    private static function sleep(ms) {
        return new Promise((resolve) => setTimeout(resolve, ms));
    }
}

/* Entry Point */
async function main() {
    // Initialize API Client
    let client = new ApiClient(
        'https://api.example.com', 
        'your-access-token'
    );

    try {
        // Example: Fetch users
        let fetchResponse = await client.get('/v1/users');
        if (fetchResponse.status === 200) {
            log.info('Fetched users: ' + JSON.stringify(fetchResponse.body));
        } else {
            log.error('Failed to fetch users: ' + fetchResponse.error);
        }

        // Example: Create user with retry logic
        let newUser = { name: 'Rune', role: 'Engineer' };
        let createResponse = await RetryableRequest.execute(
            client, 
            'POST', 
            '/v1/users', 
            newUser, 
            default_max_retries, 
            default_backoff_base
        );
        
        if (createResponse.status === 201) {
            log.info('User created successfully: ' + JSON.stringify(createResponse.body));
        } else {
            log.error('Failed to create user: ' + createResponse.error);
        }

    } catch (e) {
        log.error('Fatal error in main execution: ' + e.message);
    }
}

// Execute main
main();
