REM *** Validator Module ***
REM *** Handles data validation routines ***

SUBROUTINE ValidateRecord(index)
  REM Validate data integrity
  valid := TRUE
  
  IF PARSED_DATA[index] = "" THEN
    PRINT("Error: Empty field at index " + STR$(index))
    valid := FALSE
  END IF
  
  IF NOT IsNumeric(PARSED_DATA[index]) THEN
    PRINT("Error: Non-numeric value at index " + STR$(index))
    valid := FALSE
  END IF
  
  RETURN valid
END SUBROUTINE

FUNCTION IsNumeric(value)
  REM Check if string is numeric
  FOR i := 1 TO LEN(value)
    c := MID(value, i, 1)
    IF c < "0" OR c > "9" THEN
      IF c <> "." AND c <> "-" THEN
        RETURN FALSE
      END IF
    END IF
  END FOR
  RETURN TRUE
END FUNCTION
