package com.crypto.tool\n\nimport java.io.IOException\nimport java.security.MessageDigest\nimport java.util.Arrays\n\n/**\n * Complex Cryptographic Algorithm Implementation\n * Implements SHA-256 Hashing and HMAC-SHA256\n */\npublic class Main {\n\n    // Constants for SHA-256\n    private static val k = int[] {\n        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,\n        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,\n        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,\n        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,\n        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,\n        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,\n        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,\n        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,\n        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,\n        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,\n        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2\n    }\n\n    private static val initialHashValues = int[] {\n        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,\n        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19\n    }\n\n    public static void main(args: String[]) {\n        console.printLine("\"Complex Cryptographic Algorithm Implementation\"\n\"========================================\"\n\n\"Demonstrating SHA-256 Hashing and HMAC-SHA256\"\n\n\")\n\n        val message = \"Gosu is a statically-typed language\"\n        val key = \"secret-key\"\n\n        console.printLine(\"Message: \" + message)\n        console.printLine(\"Key: \" + key + \"\n\n\")\n\n        // 1. Basic SHA-256 Hashing\n        console.printLine(\"\"SHA-256 Hashing: \\")\n        val sha256Result = sha256(message.getBytes())\n        console.printLine(\"  Hash: \" + bytesToHex(sha256Result))\n        console.printLine(\"\"\n\")\n\n        // 2. HMAC-SHA256\n        console.printLine(\"\"HMAC-SHA256: \\")\n        val hmacResult = hmacSha256(key.getBytes(), message.getBytes())\n        console.printLine(\"  HMAC: \" + bytesToHex(hmacResult))\n        console.printLine(\"\"\n\")\n\n        // 3. Verify integrity\n        console.printLine(\"\"Integrity Check: \\")\n        val verifyMessage = \"Gosu is a statically-typed language\"\n        val verifyHash = sha256(verifyMessage.getBytes())\n        val isIntact = Arrays.equals(sha256Result, verifyHash)\n        console.printLine(\"  Message Integrity: \" + if (isIntact) \"PASSED\" else \"FAILED\")\n\n        console.printLine(\"\n\"Implementation completed successfully.\\"")\n    }\n\n    /**\n     * Computes the SHA-256 hash of a byte array.\n     *\n     * @param input The input data to hash.\n     * @return The SHA-256 hash as a byte array.\n     */\n    public static func sha256(input: byte[]): byte[] {\n        val digest = MessageDigest.getInstance(\"SHA-256\")\n        digest.update(input)\n        return digest.digest()\n    }\n\n    /**\n     * Computes the HMAC-SHA256 of a message with a given key.\n     *\n     * @param key The secret key.\n     * @param message The message to authenticate.\n     * @return The HMAC-SHA256 result.\n     */\n    public static func hmacSha256(key: byte[], message: byte[]): byte[] {\n        val blockSize = 64\n\n        // If key is longer than block size, hash it first\n        var effectiveKey = key\n        if (key.length > blockSize) {\n            effectiveKey = sha256(key)\n        }\n\n        // Pad the key to block size\n        var ipad = byte[blockSize]\n        var opad = byte[blockSize]\n        for (i in 0..key.length-1) {\n            ipad[i] = key[i]\n            opad[i] = key[i]\n        }\n\n        // XOR with inner and outer padding\n        for (i in 0..blockSize-1) {\n            ipad[i] = ipad[i] ^ 0x36\n            opad[i] = opad[i] ^ 0x5c\n        }\n\n        // Concatenate ipad with message and hash\n        val combined1 = byte[blockSize + message.length]\n        for (i in 0..blockSize-1) {\n            combined1[i] = ipad[i]\n        }\n        for (i in 0..message.length-1) {\n            combined1[blockSize + i] = message[i]\n        }\n\n        val hash1 = sha256(combined1)\n\n        // Concatenate opad with hash1 and hash again\n        val combined2 = byte[blockSize + hash1.length]\n        for (i in 0..blockSize-1) {\n            combined2[i] = opad[i]\n        }\n        for (i in 0..hash1.length-1) {\n            combined2[blockSize + i] = hash1[i]\n        }\n\n        return sha256(combined2)\n    }\n\n    /**\n     * Converts a byte array to a hexadecimal string.\n     *\n     * @param bytes The byte array to convert.\n     * @return The hexadecimal string representation.\n     */\n    public static func bytesToHex(bytes: byte[]): String {\n        val hexChars = \"0123456789ABCDEF\"\n        val sb = StringBuilder()\n        for (b in bytes) {\n            sb.append(hexChars[b.unsignedByte() / 16])\n            sb.append(hexChars[b.unsignedByte() % 16])\n        }\n        return sb.toString()\n    }\n}
