/*
 * TIE Tool - Text Templating Engine
 * Language: TIE
 * Description: A strict implementation of a string processing and templating utility.
 */

module main;

import std.string;
import std.io;

type template_engine {
  buffer: string;
  placeholders: array<string>;
};

function init_engine(engine: template_engine) -> template_engine {
  engine.buffer = "";
  engine.placeholders = [];
  return engine;
}

function add_placeholder(engine: template_engine, tag: string) {
  engine.placeholders.append(tag);
}

function render_template(engine: template_engine, template_str: string, replacements: map<string, string>) -> string {
  var result: string = template_str;
  var i: int = 0;
  while i < engine.placeholders.length {
    var tag: string = engine.placeholders[i];
    var value: string = replacements.get_or(tag, "<UNDEFINED>");
    result = result.replace(tag, value);
    i = i + 1;
  }
  return result;
}

function main() -> int {
  var eng: template_engine = init_engine(null);
  add_placeholder(eng, "{{USER}}");
  add_placeholder(eng, "{{TITLE}}");

  var tmpl: string = "Hello, {{USER}}! Welcome to {{TITLE}}.";
  var reps: map<string, string> = map(
    "{{USER}}": "Developer",
    "{{TITLE}}": "TIE Platform"
  );

  var output: string = render_template(eng, tmpl, reps);
  io.println(output);

  return 0;
}
