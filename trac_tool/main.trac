import trac.api as trac_api
import trac.xmlrpc as trac_xmlrpc

# Configuration
class TracConfig:
    def __init__(self, url, username, password):
        self.url = url
        self.username = username
        self.password = password
        self.client = trac_xmlrpc.Server(url + '/login/xmlrpc', username=username, password=password)

# API Wrapper
class TracTool:
    def __init__(self, config):
        self.client = config.client
        self.api = trac_api.Environment(config.url)

    def fetch_tickets(self, project, status=None):
        """Fetch tickets from a specific project."""
        query = f'project={project}'
        if status:
            query += f'&status={status}'
        return self.client.trac.query(query)

    def update_ticket(self, ticket_id, fields):
        """Update a specific ticket."""
        self.client.trac.ticket.update(ticket_id, fields)

    def fetch_changesets(self, project, limit=100):
        """Fetch changesets from a specific project."""
        return self.client.trac.changeset.query(project=project, limit=limit)

    def generate_report(self, report_id):
        """Generate a report based on its ID."""
        return self.client.trac.report.generate(report_id)

# Main Execution
if __name__ == '__main__':
    import argparse

    parser = argparse.ArgumentParser(description='Trac Tool')
    parser.add_argument('--url', required=True, help='Trac instance URL')
    parser.add_argument('--username', required=True, help='Username')
    parser.add_argument('--password', required=True, help='Password')
    parser.add_argument('command', nargs='?', help='Command to execute')
    parser.add_argument('--project', help='Project name')
    parser.add_argument('--status', help='Ticket status')
    parser.add_argument('--ticket-id', type=int, help='Ticket ID')
    parser.add_argument('--fields', help='Fields to update (JSON format)')
    parser.add_argument('--report-id', type=int, help='Report ID')

    args = parser.parse_args()

    config = TracConfig(args.url, args.username, args.password)
    tool = TracTool(config)

    if args.command == 'fetch_tickets':
        tickets = tool.fetch_tickets(args.project, args.status)
        print(tickets)
    elif args.command == 'update_ticket':
        fields = json.loads(args.fields)
        tool.update_ticket(args.ticket_id, fields)
        print(f'Ticket {args.ticket_id} updated.')
    elif args.command == 'fetch_changesets':
        changesets = tool.fetch_changesets(args.project)
        print(changesets)
    elif args.command == 'generate_report':
        report = tool.generate_report(args.report_id)
        print(report)
    else:
        print('Usage: python main.trac [command] [options]')
