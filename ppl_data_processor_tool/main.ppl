// PPL Data Processor - main.ppl

// Initialization
proc main()
    data = load_data("input.dat")
    processed_data = process(data)
    save_data(processed_data, "output.dat")
    print("Processing complete.")
endproc

// Data Loading
proc load_data(filename)
    // Simulated data loading logic
    return [1, 2, 3, 4, 5]
endproc

// Data Processing
proc process(data)
    result = []
    for item in data do
        result = append(result, item * 2)
    endfor
    return result
endproc

// Data Saving
proc save_data(data, filename)
    // Simulated data saving logic
    print("Saving data to " + filename)
endproc
