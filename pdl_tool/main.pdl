"RECORD extraction_record
    FIELD 1: STRING (100) : field_1
    FIELD 2: STRING (100) : field_2
    FIELD 3: STRING (100) : field_3
END_RECORD

GLOBAL delimiter_char = \",\"
GLOBAL input_filename = \"input_data.txt\"

PROCEDURE main()
    LOCAL file_handle : INTEGER
    LOCAL raw_line : STRING (200)
    LOCAL extracted_data : RECORD extraction_record

    PRINT \"Starting PDL Data Extraction Utility...\"

    OPEN input_filename FOR INPUT AS file_handle
    IF file_handle = -1 THEN
        PRINT \"Error: Unable to open input file.\"
        STOP
    END_IF

    READLINE file_handle INTO raw_line
    WHILE NOT EOF(file_handle) DO
        CALL parse_line(raw_line, extracted_data)
        CALL process_record(extracted_data)
        READLINE file_handle INTO raw_line
    END_WHILE

    CLOSE file_handle
    PRINT \"Extraction complete.\"
END_PROCEDURE

PROCEDURE parse_line(line : STRING, OUT data : RECORD extraction_record)
    LOCAL pos : INTEGER
    LOCAL field_start : INTEGER
    LOCAL field_content : STRING (100)

    pos = 1
    CALL extract_field(line, pos, data.field_1)
    CALL extract_field(line, pos, data.field_2)
    CALL extract_field(line, pos, data.field_3)
END_PROCEDURE

PROCEDURE extract_field(input : STRING, INOUT cursor : INTEGER, OUT field_val : STRING)
    LOCAL char_code : INTEGER
    LOCAL current_char : STRING (1)

    field_val = \"\"
    WHILE cursor <= LENGTH(input) DO
        current_char = SUBSTRING(input, cursor, 1)
        char_code = ASC(current_char)

        IF char_code = ASC(delimiter_char) THEN
            cursor = cursor + 1
            EXIT
        ELSE
            field_val = field_val + current_char
            cursor = cursor + 1
        END_IF
    END_WHILE
END_PROCEDURE

PROCEDURE process_record(data : RECORD extraction_record)
    PRINT \"Extracted Field 1: \" + data.field_1
    PRINT \"Extracted Field 2: \" + data.field_2
    PRINT \"Extracted Field 3: \" + data.field_3
END_PROCEDURE
"
