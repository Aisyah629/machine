PROGRAM NATURAL_DATA_PROCESSOR

  ! Define Data Structure
  DEFINE DATA LOCAL
  1 EMPLOYEE-DATA-TABLE
    2 EMPLOYEE-ID NUMERIC(5)
    2 FIRST-NAME CHAR(20)
    2 LAST-NAME CHAR(20)
    2 SALARY NUMERIC(8,2)
    2 DEPT CHAR(10)
  1 RESULTS-TABLE
    2 INDEX NUMERIC(5)
    2 TOTAL-SALARY NUMERIC(12,2)
    2 COUNT NUMERIC(5)
  END-DEFINE

  ! Initialize variables
  MOVE 0 TO RESULTS-TABLE.TOTAL-SALARY
  MOVE 0 TO RESULTS-TABLE.COUNT

  ! Read records from standard input (simulated)
  DISPLAY "START PROCESSING DATA..."

  ! Process a sample dataset
  EXECUTE PROCESS_RECORD
    MOVE 1001 TO EMPLOYEE-ID
    MOVE 'JOHN' TO FIRST-NAME
    MOVE 'DOE' TO LAST-NAME
    MOVE 5000.00 TO SALARY
    MOVE 'ENGINEERING' TO DEPT
    EXECUTE VALIDATE_RECORD
    EXECUTE AGGREGATE_DATA
  END-EXECUTE

  EXECUTE PROCESS_RECORD
    MOVE 1002 TO EMPLOYEE-ID
    MOVE 'JANE' TO FIRST-NAME
    MOVE 'SMITH' TO LAST-NAME
    MOVE 6000.00 TO SALARY
    MOVE 'MARKETING' TO DEPT
    EXECUTE VALIDATE_RECORD
    EXECUTE AGGREGATE_DATA
  END-EXECUTE

  ! Display final results
  DISPLAY "PROCESSING COMPLETE."
  DISPLAY "TOTAL SALARY EXPENSE: " RESULTS-TABLE.TOTAL-SALARY
  DISPLAY "EMPLOYEES PROCESSED: " RESULTS-TABLE.COUNT

END-PARAMETERS

! Subroutine: Validate Record
SUBROUTINE VALIDATE_RECORD
  IF EMPLOYEE-ID = 0 OR SALARY < 0
    DISPLAY "INVALID RECORD: EMPLOYEE-ID=" EMPLOYEE-ID
    SKIP
  ELSE
    DISPLAY "RECORD VALID: " EMPLOYEE-ID " " FIRST-NAME " " LAST-NAME
  END-IF
END-SUBROUTINE

! Subroutine: Aggregate Data
SUBROUTINE AGGREGATE_DATA
  RESULTS-TABLE.TOTAL-SALARY = RESULTS-TABLE.TOTAL-SALARY + SALARY
  RESULTS-TABLE.COUNT = RESULTS-TABLE.COUNT + 1
END-SUBROUTINE

! Subroutine: Process Record
SUBROUTINE PROCESS_RECORD
  EXECUTE VALIDATE_RECORD
  IF EMPLOYEE-ID > 0 AND SALARY >= 0
    EXECUTE AGGREGATE_DATA
  END-IF
END-SUBROUTINE

END-PROGRAM
