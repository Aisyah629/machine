     TITLE TELCOMP_DATA_PROCESSOR
     IDENTIFICATION
        PROCEDURE-DATA-PROCESSOR.
        AUTHOR: Autonomous AI Polyglot Software Engineer.
        DATE-COMPILED: TODAY.
     ENVIRONMENT
        CONFIGURATION-SPECIAL.
        ORGANIZATION IS RECORD.
        FILE-CONTROL.
            SELECT INPUT-FILE ASSIGN TO CARD-INPUT.
            SELECT OUTPUT-FILE ASSIGN TO LINE-PRINTER.
     DATA DIVISION.
        FILE SECTION.
        FD INPUT-FILE.
        01 INPUT-RECORD.
            05 DATA-FIELD PIC X(80).
        FD OUTPUT-FILE.
        01 OUTPUT-RECORD.
            05 RESULT-FIELD PIC X(80).
     WORKING-STORAGE SECTION.
        01 END-OF-FILE PIC 9 VALUE 0.
        01 RECORD-COUNTER PIC 9(5) VALUE 0.
        01 PROCESSING-FLAG PIC X VALUE 'Y'.
     PROCEDURE DIVISION.
        START-PROCESSING.
            PERFORM OPEN-FILES.
            PERFORM READ-AND-PROCESS UNTIL END-OF-FILE = 1.
            PERFORM CLOSE-FILES.
            STOP RUN.
        OPEN-FILES.
            OPEN INPUT INPUT-FILE.
            OPEN OUTPUT OUTPUT-FILE.
        READ-AND-PROCESS.
            READ INPUT-FILE INTO DATA-FIELD.
            IF END-OF-FILE = 1 THEN
                CONTINUE
            ELSE
                PERFORM TRANSFORM-DATA
        TRANSFORM-DATA.
            ADD 1 TO RECORD-COUNTER.
            MOVE DATA-FIELD TO RESULT-FIELD.
            WRITE OUTPUT-RECORD.
        CLOSE-FILES.
            CLOSE INPUT-FILE.
            CLOSE OUTPUT-FILE.
