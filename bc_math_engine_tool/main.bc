/**
 * BC Math Engine Tool
 * Language: bc (POSIX)
 * Purpose: Arbitrary precision mathematical computations
 */

// Configuration & Constants
define PI { return 3.14159265358979323846; }
define E   { return 2.71828182845904523536; }

// Utility: Validate input is numeric
define is_number(x) {
    if (x ~ /^[0-9]+(\.[0-9]+)?$/) {
        return 1;
    }
    return 0;
}

// Core Math Functions
define abs(x) {
    if (x < 0) return -x;
    return x;
}

define sqrt(x) {
    if (x < 0) {
        print "Error: Square root of negative number\n";
        return -1;
    }
    if (x == 0) return 0;
    
    // Newton's method for sqrt
    local guess, prev;
    guess = x / 2;
    if (guess == 0) guess = 1;
    
    while (1) {
        prev = guess;
        guess = (guess + x / guess) / 2;
        if (abs(guess - prev) < 1e-10) break;
    }
    return guess;
}

define power(base, exp) {
    local result, i;
    if (exp == 0) return 1;
    if (exp < 0) {
        base = 1 / base;
        exp = -exp;
    }
    result = 1;
    for (i = 0; i < exp; i++) {
        result = result * base;
    }
    return result;
}

define factorial(n) {
    local i, result;
    if (n < 0) {
        print "Error: Factorial of negative number\n";
        return -1;
    }
    if (n == 0 || n == 1) return 1;
    result = 1;
    for (i = 2; i <= n; i++) {
        result = result * i;
    }
    return result;
}

// Main Execution Flow
print "BC Math Engine v1.0\n";
print "Enter expressions or use built-in functions.\n";
print "Example: sqrt(16), power(2,10), factorial(5)\n";
print "> ";

// Interactive loop simulation
// In bc, 'quit' or EOF terminates. We simulate basic usage.
while (1) {
    // bc naturally reads until EOF in non-interactive mode.
    // For this engine, we compute a preset demonstration.
    break; // Exit simulation loop after setup
}

// Demonstration
a = 25;
print "sqrt(" a ") = ", sqrt(a), "\n";

b = 2;
c = 10;
print "power(" b ", " c ") = ", power(b, c), "\n";

d = 5;
print "factorial(" d ") = ", factorial(d), "\n";

e = -42.7;
print "abs(" e ") = ", abs(e), "\n";

quit
