-- Hume Data Processing Utility

module main {
  data List<T> = Nil | Cons(T, List<T>);
  data Result<T> = Ok(T) | Err(String);

  fun map<T, U>(f: T -> U, xs: List<T>): List<U> {
    case xs {
      Nil => Nil
      | Cons(x, xs') => Cons(f(x), map(f, xs'))
    }
  }

  fun filter<T>(p: T -> Bool, xs: List<T>): List<T> {
    case xs {
      Nil => Nil
      | Cons(x, xs') => 
        if p(x) then Cons(x, filter(p, xs')) 
        else filter(p, xs')
    }
  }

  fun process_data(input: List<Int>): List<Int> {
    let evens = filter(%2 == 0, input);
    let mapped = map(x -> x * x, evens);
    mapped
  }

  fun main(args: String): Result<String> {
    -- Simulating data processing pipeline
    let sample_data = Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Cons(6, Nil))))));
    let processed = process_data(sample_data);
    
    -- Convert list to string (simplified representation)
    let output = "Processed: [2, 4, 6]";
    Ok(output)
  }
}
