Object subclass: #SecureScriptEnvironment instanceVariableNames: 'rootClass' classVariableNames: '' poolDictionaries: '' category: 'NewspeakTool'.

SecureScriptEnvironment methodsFor: 'accessing'!

rootClass
    ^ rootClass.

rootClass: anObject
    rootClass := anObject.

! !

SecureScriptEnvironment methodsFor: 'initialization'!

initialize
    super initialize.
    rootClass := nil.
    self defineRootClass.
    self createSecureEnvironment.

! !

SecureScriptEnvironment methodsFor: 'private'!

defineRootClass
    "Create the root class for the secure environment."
    rootClass := Object subclass: #EnvironmentRoot instanceVariableNames: 'secureContext' classVariableNames: '' poolDictionaries: '' category: 'SecureEnvironment'.
    rootClass subclass: #Module instanceVariableNames: 'name components' classVariableNames: '' poolDictionaries: '' category: 'SecureEnvironment'.
    rootClass subclass: #SecureComponent instanceVariableNames: 'parent' classVariableNames: '' poolDictionaries: '' category: 'SecureEnvironment'.

createSecureEnvironment
    "Initialize the secure context and root module."
    secureContext := Dictionary new.
    secureContext at: 'securityLevel' put: 'high'.
    secureContext at: 'encryptionEnabled' put: true.
    secureContext at: 'debugMode' put: false.

! !

SecureScriptEnvironment methodsFor: 'operations'!

declareModule: moduleName
    "Declare a new module within the secure environment."
    | newModule | 
    newModule := rootClass organization moduleNamed: moduleName ifAbsent: [Module new: moduleName].
    self ensureUniqueModuleName: moduleName.
    ^ newModule.

secureExecutionOf: aBlock
    "Execute a block within a secure context."
    | result | 
    [ result := aBlock value ]
        on: Exception
        do: [:ex | 
            self logError: ex messageText.
            ^ nil].
    ^ result.

logError: errorMessage
    "Log an error message securely."
    (self secureContext at: 'securityLevel') = 'high'
        ifTrue: [ Transcript show: 'SECURITY: ', errorMessage. Transcript cr ]
        ifFalse: [ Transcript show: errorMessage. Transcript cr ].

secureContext
    ^ secureContext.

ensureUniqueModuleName: aName
    "Ensure module names are unique within the root context."
    rootClass organization isNil
        ifTrue: [ rootClass organization: (Organization new named: aName) ]
        ifFalse: [ 
            (rootClass organization memberNames includes: aName)
                ifTrue: [ self error: 'Module name already exists' ]
        ].

! !

Module methodsFor: 'initialization'!

initialize: moduleName
    super initialize.
    name := moduleName.
    components := OrderedCollection new.

name
    ^ name.

components
    ^ components.

addComponent: aComponent
    components add: aComponent.
    aComponent parent: self.

! !

SecureComponent methodsFor: 'initialization'!

parent: aModule
    parent := aModule.

parent
    ^ parent.

! !
