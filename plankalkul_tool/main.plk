; Plankalkül Main Program
; A simple example of a Plankalkül program

; Define variables
VAR
  A, B, C : BOOLEAN
  X, Y, Z : INTEGER

; Initialize variables
A := TRUE
B := FALSE
C := NOT A AND B

; Calculate values
X := 10
Y := 20
Z := X + Y

; Output results
IF C THEN
  PRINT "C is TRUE"
ELSE
  PRINT "C is FALSE"
END_IF

PRINT "Z = " + Z

; End of program
HALT
