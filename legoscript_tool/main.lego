// System Constants
#define MAX_MOTORS 8
#define MAX_SENSORS 16
#define TICK_RATE 1000 // ms

// Data Structures
struct MotorConfig {
    int id;
    float power;
    int direction; // 1 forward, -1 reverse
    float speed;
    bool enabled;
}

struct SensorData {
    int id;
    float value;
    string type; // "ultrasonic", "gyro", "touch"
}

// Global State
MotorConfig motors[MAX_MOTORS];
SensorData sensors[MAX_SENSORS];
bool simulation_running = false;
float current_time = 0.0;

// Initialization
function init_robot() {
    print("Initializing Robotics Framework...");
    
    // Initialize default motors
    for (i = 0; i < MAX_MOTORS; i++) {
        motors[i].id = i;
        motors[i].power = 0.0;
        motors[i].direction = 1;
        motors[i].speed = 0.0;
        motors[i].enabled = false;
    }
    
    // Initialize default sensors
    for (i = 0; i < MAX_SENSORS; i++) {
        sensors[i].id = i;
        sensors[i].value = 0.0;
        sensors[i].type = "unknown";
    }
    
    print("Framework Ready.");
}

// Motor Control API
function set_motor_power(motor_id, power) {
    if (motor_id >= 0 && motor_id < MAX_MOTORS) {
        if (power >= -1.0 && power <= 1.0) {
            motors[motor_id].power = power;
            motors[motor_id].enabled = true;
            log_event("MOTOR_SET", motor_id, power);
        } else {
            log_event("ERROR", -1, "Invalid power value for motor " + motor_id);
        }
    } else {
        log_event("ERROR", -1, "Invalid motor ID: " + motor_id);
    }
}

function set_motor_direction(motor_id, direction) {
    if (motor_id >= 0 && motor_id < MAX_MOTORS) {
        if (direction == 1 || direction == -1) {
            motors[motor_id].direction = direction;
            log_event("MOTOR_DIR", motor_id, direction);
        } else {
            log_event("ERROR", -1, "Invalid direction for motor " + motor_id);
        }
    }
}

function stop_motor(motor_id) {
    if (motor_id >= 0 && motor_id < MAX_MOTORS) {
        motors[motor_id].power = 0.0;
        motors[motor_id].enabled = false;
        log_event("MOTOR_STOP", motor_id, 0.0);
    }
}

// Sensor Simulation API
function simulate_sensor_read(sensor_id, value) {
    if (sensor_id >= 0 && sensor_id < MAX_SENSORS) {
        sensors[sensor_id].value = value;
        log_event("SENSOR_READ", sensor_id, value);
    }
}

// Simulation Loop
function run_simulation_loop(duration_seconds) {
    simulation_running = true;
    end_time = current_time + duration_seconds;
    
    while (current_time < end_time) {
        process_motors();
        process_sensors();
        current_time += 0.1; // Advance 100ms
        
        // Check for stop condition
        if (!simulation_running) break;
    }
    
    print("Simulation completed. Total time: " + current_time + "s");
}

function process_motors() {
    for (i = 0; i < MAX_MOTORS; i++) {
        if (motors[i].enabled) {
            // Apply physics logic (simplified)
            position_change = motors[i].power * motors[i].speed * 0.1;
            // In a full engine, this would update wheel ticks or kinematics
        }
    }
}

function process_sensors() {
    for (i = 0; i < MAX_SENSORS; i++) {
        if (sensors[i].type != "unknown") {
            // Simulate noise or state updates
            sensors[i].value += (random() * 0.1 - 0.05);
        }
    }
}

// Logging
function log_event(type, id, value) {
    print("[" + format_time(current_time) + "] " + type + ": ID=" + id + ", VAL=" + value);
}

function format_time(t) {
    return t.toFixed(1);
}

function random() {
    // Simple pseudo-random for simulation
    return ((current_time * 1000) % 100) / 100.0;
}

// Main Entry
init_robot();

// Example Usage
set_motor_power(0, 0.5);
set_motor_power(1, 0.5);
simulate_sensor_read(0, 15.5); // Ultrasonic sensor 15.5cm

run_simulation_loop(5.0); // Run for 5 seconds

stop_motor(0);
stop_motor(1);
