%{
/*
 * Flex Data Processing Utility
 * This file demonstrates a simple lexical analyzer for data processing.
 */
#include <stdio.h>
#include <string.h>

int yylineno = 1;
int error_count = 0;

void yyerror(const char *s) {
    fprintf(stderr, "Line %d: %s\n", yylineno, s);
    error_count++;
}

%}

digit   [0-9]
number  {digit}+({digit}*)?
string  "[^"]*"[^"]*
identifier [a-zA-Z_][a-zA-Z0-9_]*
whitespace [ \t]+
newline \n

%%

{number}    { printf("NUMBER: %s\n", yytext); }
{string}    { printf("STRING: %s\n", yytext); }
{identifier} { printf("IDENTIFIER: %s\n", yytext); }
{whitespace} { /* ignore */ }
{newline}   { yylineno++; }
"//"[^"]*   { /* ignore comments */ }
"""          { /* handle unclosed string */ }
.           { printf("UNRECOGNIZED: %s\n", yytext); }

%%

int main(int argc, char **argv) {
    if (argc > 1) {
        FILE *file;
        if ((file = fopen(argv[1], "r")) == NULL) {
            fprintf(stderr, "Error: Cannot open file %s\n", argv[1]);
            return 1;
        }
        yyin = file;
    }
    
    yylex();
    
    if (error_count > 0) {
        fprintf(stderr, "\nErrors found: %d\n", error_count);
        return 1;
    }
    
    return 0;
}

int yywrap(void) {
    return 1;
}
