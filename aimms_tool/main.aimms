# AIMMS Project: Supply Chain Optimization

! Declarations
set Products := 'Product1' 'Product2' 'Product3';
set Warehouses := 'Warehouse1' 'Warehouse2' 'Warehouse3';
set Customers := 'Customer1' 'Customer2' 'Customer3';

parameter ProductionCost { indexset: Products; };
parameter WarehouseCapacity { indexset: Warehouses; };
parameter CustomerDemand { indexset: Customers; };
parameter TransportationCost { indexset: (Products, Warehouses, Customers); };

var Production { indexset: Products; };
var Shipment { indexset: (Products, Warehouses, Customers); };
var TotalCost;

! Constraints
Production <= 100;
Shipment <= WarehouseCapacity;
Shipment >= CustomerDemand;

! Objective
TotalCost := sum(p:Products, q:Warehouses, r:Customers) (TransportationCost(p,q,r) * Shipment(p,q,r)) + sum(p:Products, ProductionCost(p) * Production(p));
model minimize TotalCost;

! Initialization
ProductionCost('Product1') := 10;
ProductionCost('Product2') := 20;
ProductionCost('Product3') := 30;

WarehouseCapacity('Warehouse1') := 50;
WarehouseCapacity('Warehouse2') := 60;
WarehouseCapacity('Warehouse3') := 70;

CustomerDemand('Customer1') := 20;
CustomerDemand('Customer2') := 25;
CustomerDemand('Customer3') := 30;

TransportationCost('Product1', 'Warehouse1', 'Customer1') := 1;
TransportationCost('Product1', 'Warehouse1', 'Customer2') := 2;
TransportationCost('Product1', 'Warehouse1', 'Customer3') := 3;
TransportationCost('Product1', 'Warehouse2', 'Customer1') := 4;
TransportationCost('Product1', 'Warehouse2', 'Customer2') := 5;
TransportationCost('Product1', 'Warehouse2', 'Customer3') := 6;
TransportationCost('Product1', 'Warehouse3', 'Customer1') := 7;
TransportationCost('Product1', 'Warehouse3', 'Customer2') := 8;
TransportationCost('Product1', 'Warehouse3', 'Customer3') := 9;

TransportationCost('Product2', 'Warehouse1', 'Customer1') := 1;
TransportationCost('Product2', 'Warehouse1', 'Customer2') := 2;
TransportationCost('Product2', 'Warehouse1', 'Customer3') := 3;
TransportationCost('Product2', 'Warehouse2', 'Customer1') := 4;
TransportationCost('Product2', 'Warehouse2', 'Customer2') := 5;
TransportationCost('Product2', 'Warehouse2', 'Customer3') := 6;
TransportationCost('Product2', 'Warehouse3', 'Customer1') := 7;
TransportationCost('Product2', 'Warehouse3', 'Customer2') := 8;
TransportationCost('Product2', 'Warehouse3', 'Customer3') := 9;

TransportationCost('Product3', 'Warehouse1', 'Customer1') := 1;
TransportationCost('Product3', 'Warehouse1', 'Customer2') := 2;
TransportationCost('Product3', 'Warehouse1', 'Customer3') := 3;
TransportationCost('Product3', 'Warehouse2', 'Customer1') := 4;
TransportationCost('Product3', 'Warehouse2', 'Customer2') := 5;
TransportationCost('Product3', 'Warehouse2', 'Customer3') := 6;
TransportationCost('Product3', 'Warehouse3', 'Customer1') := 7;
TransportationCost('Product3', 'Warehouse3', 'Customer2') := 8;
TransportationCost('Product3', 'Warehouse3', 'Customer3') := 9;

! Execution
solve model;
