/*
 * ESPOL (Executable Specification of Processes and Languages) Tool
 * 
 * Objective: Implement a formal process specification engine for verifying
 * concurrent system behaviors with rigorous syntax validation.
 */

MODULE ProcessSpecEngine;

IMPORTS 
    SyntaxParser,
    ConcurrentLogic,
    ValidationRules;

/*
 * Process Definition Structure
 * Represents a concurrent process with entry points and transitions.
 */
TYPE ProcessDefinition = RECORD
    name: String;
    states: List[State];
    transitions: List[Transition];
    invariants: List[Invariant];
END RECORD;

TYPE State = RECORD
    id: Integer;
    label: String;
    properties: Map[String, Value];
END RECORD;

TYPE Transition = RECORD
    source: Integer;
    target: Integer;
    trigger: Expression;
    guard: BooleanExpression;
    action: Action;
END RECORD;

TYPE Invariant = RECORD
    condition: BooleanExpression;
    scope: List[State];
END RECORD;

/*
 * Main Execution Entry Point
 * Parses input, validates syntax, and runs the verification engine.
 */
PROCEDURE Main():
    PRINT "Initializing ESPOL Process Specification Engine..."
    
    DECLARE specInput: String;
    DECLARE parsedSpec: Optional[ProcessDefinition];
    DECLARE errors: List[String];
    
    /* Step 1: Load and Parse Specification */
    specInput = System.stdin.read();
    
    PRINT "Parsing ESPOL specification...";
    parsedSpec = SyntaxParser.parse(specInput, errors);
    
    IF parsedSpec.isNone() THEN
        PRINT "Parsing failed:";
        FOREACH err IN errors DO
            PRINT "  - " + err;
        END FOREACH
        System.exit(1);
    END IF;
    
    /* Step 2: Validate Syntax and Semantics */
    PRINT "Validating syntax and concurrent behaviors...";
    DECLARE valid: Boolean;
    valid = ValidationRules.validate(parsedSpec.value, errors);
    
    IF NOT valid THEN
        PRINT "Validation failed:";
        FOREACH err IN errors DO
            PRINT "  - " + err;
        END FOREACH
        System.exit(2);
    END IF;
    
    /* Step 3: Verify Concurrent Behaviors */
    PRINT "Verifying concurrent system behaviors...";
    DECLARE conflicts: List[Conflict];
    conflicts = ConcurrentLogic.checkConflicts(parsedSpec.value);
    
    IF NOT conflicts.isEmpty() THEN
        PRINT "Potential concurrency conflicts detected:";
        FOREACH conflict IN conflicts DO
            PRINT "  - " + conflict.toString();
        END FOREACH
    ELSE
        PRINT "No concurrency conflicts detected. Specification is consistent."
    END IF;
    
    PRINT "Execution complete."
END PROCEDURE;

END MODULE;
