// Lucid Data Processor Tool
// A utility for data processing

function processData(input, config) {
    // Initialize processing state
    let state = {
        records: [],
        errors: [],
        stats: {
            total: 0,
            processed: 0,
            skipped: 0
        }
    };

    // Validate input
    if (!input || typeof input !== 'object') {
        throw new Error('Invalid input: Expected an object');
    }

    // Apply configuration defaults
    const defaultConfig = {
        batchSize: 100,
        validate: true,
        transform: true,
        clean: true
    };

    const processedConfig = Object.assign({}, defaultConfig, config);

    // Process records in batches
    const records = Array.isArray(input.records) ? input.records : [input];
    state.stats.total = records.length;

    for (let i = 0; i < records.length; i++) {
        try {
            let record = records[i];
            
            // Validation step
            if (processedConfig.validate) {
                record = validateRecord(record);
            }
            
            // Cleaning step
            if (processedConfig.clean) {
                record = cleanRecord(record);
            }
            
            // Transformation step
            if (processedConfig.transform) {
                record = transformRecord(record);
            }
            
            state.records.push(record);
            state.stats.processed++;
        } catch (error) {
            state.errors.push({
                recordIndex: i,
                error: error.message
            });
            state.stats.skipped++;
        }
    }

    // Generate summary statistics
    state.summary = generateSummary(state);

    return state;
}

function validateRecord(record) {
    // Basic validation rules
    if (!record) {
        throw new Error('Record is null or undefined');
    }
    
    // Check for required fields
    const requiredFields = ['id', 'timestamp'];
    for (const field of requiredFields) {
        if (record[field] === undefined || record[field] === null) {
            throw new Error(`Missing required field: ${field}`);
        }
    }
    
    return record;
}

function cleanRecord(record) {
    const cleaned = { ...record };
    
    // Remove extra whitespace from string fields
    for (const key in cleaned) {
        if (typeof cleaned[key] === 'string') {
            cleaned[key] = cleaned[key].trim();
        }
    }
    
    return cleaned;
}

function transformRecord(record) {
    const transformed = { ...record };
    
    // Convert timestamp to standard format
    if (transformed.timestamp) {
        transformed.timestamp = new Date(transformed.timestamp).toISOString();
    }
    
    // Calculate derived fields
    transformed.processed = true;
    transformed.processedAt = new Date().toISOString();
    
    return transformed;
}

function generateSummary(state) {
    return {
        totalRecords: state.stats.total,
        processedRecords: state.stats.processed,
        skippedRecords: state.stats.skipped,
        errorCount: state.errors.length,
        errorDetails: state.errors
    };
}

// Export the main function
module.exports = { processData };
