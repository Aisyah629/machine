/* CLIST Data Processing Tool */
/* Process data records and output formatted results */

OPTIONS RESTARTS

/* Initialize variables */
PARSE VAR &ARG1 DATA_FILE_NAME
PARSE VAR &ARG2 OUTPUT_FILE_NAME

IF &DATA_FILE_NAME EQ '' THEN DO
  SAY 'ERROR: DATA FILE NAME REQUIRED'
  SAY 'USAGE: CLIST_DATA_PROC <INPUT_FILE> [OUTPUT_FILE]'
  EXIT 1
END

/* Check if input file exists */
ALLOC FI(INPUT) DA(&DATA_FILE_NAME) SHR
IF RC NE 0 THEN DO
  SAY 'ERROR: CANNOT OPEN INPUT FILE &DATA_FILE_NAME'
  EXIT 1
END

IF &OUTPUT_FILE_NAME NE '' THEN DO
  FREE FI(OUTPUT)
  ALLOC FI(OUTPUT) DA(&OUTPUT_FILE_NAME) NEW
  IF RC NE 0 THEN DO
    SAY 'ERROR: CANNOT CREATE OUTPUT FILE &OUTPUT_FILE_NAME'
    FREE FI(INPUT)
    EXIT 1
  END
END ELSE DO
  /* Default output to SYSOUT if not specified */
  ALLOC FI(OUTPUT) SYSOUT
END

/* Process records */
DO WHILE RC EQ 0
  GET FILE(INPUT) INTO(RECORD)
  IF RC EQ 0 THEN DO
    /* Perform data processing logic here */
    /* Example: Extract first 80 characters and convert to upper case */
    PROCESSED = TRANSLATE(SUBSTR(RECORD, 1, 80))
    SAY PROCESSED
    PUT FILE(OUTPUT) DATA(PROCESSED)
  END
END

FREE FI(INPUT)
IF &OUTPUT_FILE_NAME NE '' THEN FREE FI(OUTPUT)

EXIT 0
