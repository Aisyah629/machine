* PL360 UTILITY FOR LOW-LEVEL SYSTEM INSTRUCTION HANDLING
* THIS CODE DEMONSTRATES BASIC SYSTEM CALLS AND REGISTERS HANDLING

         SETENV  PASS,1       * SET ENVIRONMENT VARIABLE
         STM   14,12,12(13)  * SAVE REGISTERS
         LR    12,15        * CALCULATE BASE ADDRESS
         BAL   14,XTENSION * BRANCH TO EXTENSION
         DC    16F'0'       * SAVE AREA
         USING  *,12        * SET CURRENT BASE REGISTER
         LA    15,=V(SA)    * LOAD SAVE ADDRESS
         STM   0,14,12(13)  * SAVE REGISTERS AGAIN
         LR    13,15        * UPDATE BASE POINTER
         LR    15,12        * SET RETURN ADDRESS
         STM   14,12,12(13) * SAVE REGISTERS FINAL
         LR    12,15        * CALCULATE BASE ADDRESS
         BAL   14,XTENSION * BRANCH TO EXTENSION
         DC    16F'0'       * SAVE AREA
         USING  *,12        * SET CURRENT BASE REGISTER
         LA    15,=V(SA)    * LOAD SAVE ADDRESS
         STM   0,14,12(13)  * SAVE REGISTERS AGAIN
         LR    13,15        * UPDATE BASE POINTER
         LR    15,12        * SET RETURN ADDRESS
         STM   14,12,12(13) * SAVE REGISTERS FINAL
         LR    12,15        * CALCULATE BASE ADDRESS
         BAL   14,XTENSION * BRANCH TO EXTENSION
         DC    16F'0'       * SAVE AREA
         USING  *,12        * SET CURRENT BASE REGISTER
         LA    15,=V(SA)    * LOAD SAVE ADDRESS
         STM   0,14,12(13)  * SAVE REGISTERS AGAIN
         LR    13,15        * UPDATE BASE POINTER
         LR    15,12        * SET RETURN ADDRESS
         C       15,=A(0)   * CHECK IF NULL
         BNE   EXIT         * IF NOT NULL, EXIT
         LA    15,1         * RETURN CODE 1
         BXH   14,=A(0),RETURN * RETURN TO CALLER
         RETURN
SA       DS    0H
         END
