import java.io.{File, InputStreamReader}
import java.util.{ArrayList, List, Map, HashMap}

class Main {

    static var logger: Logger = new Logger()
    static var config: Map<String, String> = new HashMap<String, String>()

    static function main(args: String[]) {
        logger.info("Initializing Gosu Data Processing Engine...")
        loadConfig()
        var pipeline: DataPipeline = new DataPipeline()
        var inputPath: String = config.getOrDefault("input_path", "data/input.csv")
        var outputPath: String = config.getOrDefault("output_path", "data/output.json")
        
        try {
            logger.info("Loading data from " + inputPath)
            var rawData: List<Map<String, Object>> = loadCSV(inputPath)
            logger.info("Loaded " + rawData.size() + " records.")
            
            logger.info("Processing data...")
            var processedData: List<Map<String, Object>> = pipeline.execute(rawData)
            
            logger.info("Saving results to " + outputPath)
            saveJSON(processedData, outputPath)
            logger.info("Data processing completed successfully.")
        } catch (e: Exception) {
            logger.error("Failed to process data: " + e.getMessage())
            e.printStackTrace()
            System.exit(1)
        }
    }

    static function loadConfig() {
        // Simulated config loading
        config.put("input_path", "data/input.csv")
        config.put("output_path", "data/output.json")
        config.put("processing_mode", "batch")
    }

    static function loadCSV(path: String): List<Map<String, Object>> {
        var records: List<Map<String, Object>> = new ArrayList<Map<String, Object>>()
        var file: File = new File(path)
        if (!file.exists()) {
            throw new Exception("Input file not found: " + path)
        }
        
        var reader: InputStreamReader = new InputStreamReader(new FileInputStream(path))
        var lines: String[] = reader.readAllLines()
        reader.close()
        
        if (lines.length == 0) return records
        
        var headers: String[] = lines[0].split(",")
        for (var i: Integer = 1; i < lines.length; i++) {
            var values: String[] = lines[i].split(",")
            var record: Map<String, Object> = new HashMap<String, Object>()
            for (var j: Integer = 0; j < headers.length; j++) {
                record.put(headers[j].trim(), values.length > j ? values[j].trim() : "")
            }
            records.add(record)
        }
        return records
    }

    static function saveJSON(data: List<Map<String, Object>>, path: String) {
        var file: File = new File(path)
        file.getParentFile().mkdirs()
        var writer: FileWriter = new FileWriter(file)
        writer.write("[\n")
        for (var i: Integer = 0; i < data.size(); i++) {
            writer.write("  {")
            var first: Boolean = true
            for (var entry: Map.Entry<String, Object> : data[i].entrySet()) {
                if (!first) writer.write(", ")
                writer.write("\"" + entry.getKey() + "\": \"" + entry.getValue() + "\"")
                first = false
            }
            writer.write("}\")
            if (i < data.size() - 1) writer.write(",\n") else writer.write("\n")
        }
        writer.write("]\n")
        writer.close()
    }
}

class DataPipeline {
    function execute(data: List<Map<String, Object>>): List<Map<String, Object>> {
        var result: List<Map<String, Object>> = new ArrayList<Map<String, Object>>()
        for (var record: Map<String, Object> : data) {
            var processed: Map<String, Object> = new HashMap<String, Object>()
            for (var key: String : record.keySet()) {
                var value: Object = record.get(key)
                // Simple transformation example: uppercase strings
                if (value instanceof String) {
                    processed.put(key, ((String)value).toUpperCase())
                } else {
                    processed.put(key, value)
                }
            }
            processed.put("processed_at", new Date().toString())
            result.add(processed)
        }
        return result
    }
}

class Logger {
    function info(msg: String) {
        System.out.println("[INFO] " + msg)
    }
    function error(msg: String) {
        System.err.println("[ERROR] " + msg)
    }
}

import java.io.{File, InputStreamReader, FileWriter}
import java.util.{ArrayList, List, Map, HashMap}
import java.io.FileInputStream
