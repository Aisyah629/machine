-- ParaSail Main Module\n\ninterface DataProcessor_Interface\n    -- Process input string and return processed result\n    operation ProcessData(Input : in String) -> Output : String;\n    \n    -- Calculate length of input string\n    operation StringLength(S : in String) -> Len : Integer;\nend DataProcessor_Interface;\n\nimplementation DataProcessor\n    implements DataProcessor_Interface\n    \n    operation ProcessData(Input : in String) -> Output : String\n        begin\n            -- Transform input to uppercase\n            Output := Upper(Input);\n            -- Append processing tag\n            Output := Output + \" [PROCESSED]\";\n        end ProcessData;\n        \n    operation StringLength(S : in String) -> Len : Integer\n        begin\n            Len := Length(S);\n        end StringLength;\nend DataProcessor;\n\n-- Main execution block\nbegin\n    local Processor : DataProcessor_Interface := new DataProcessor;\n    local Result : String := Processor.ProcessData(\"hello world\");\n    local Len : Integer := Processor.StringLength(Result);\n    \n    print(\"Processed: \");\n    print(Result);\n    print(\"Length: \");\n    print(Len);\n    \n    -- Demonstrate concurrent processing\n    task\n        local Res : String := Processor.ProcessData(\"concurrent test\");\n        print(\"Concurrent Result: \");\n        print(Res);\n    end task;\n    \nend;\n
