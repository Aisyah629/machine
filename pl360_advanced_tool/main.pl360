      ENTRY SIMULATOR
      SAVE  (14,12)
      LA    12,SIMULAT
      SR    15,15
      ST    15,CONDCC
      CALL  ,DECODE,
      CALL  ,EXECUTE,
      RETURN
SIMULAT  DS    0D
CONDCC   DC    F'0'
R1       DC    F'0'
R2       DC    F'0'
R3       DC    F'0'
R4       DC    F'0'
R5       DC    F'0'
R6       DC    F'0'
R7       DC    F'0'
R8       DC    F'0'
R9       DC    F'0'
R10      DC    F'0'
R11      DC    F'0'
R12      DC    F'0'
R13      DC    F'0'
R14      DC    F'0'
R15      DC    F'0'
DECODE   LA    1,INST
         OTH   ,MAIN
         JR    15
EXECUTE  NOP
MAIN     ST    1,R1
         ST    2,R2
         ST    3,R3
         ST    4,R4
         ST    5,R5
         ST    6,R6
         ST    7,R7
         ST    8,R8
         ST    9,R9
         ST    10,R10
         ST    11,R11
         ST    12,R12
         ST    13,R13
         ST    14,R14
         ST    15,R15
         RETURN
INST     DC    AL2(0)
      END
