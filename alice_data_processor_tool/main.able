// Alice Data Processor Tool
// Main processing module for data streams

import System.IO;
import System.Process;
import Data.List;
import Data.Maybe;

-- Define the Data Record structure
type DataRecord = {
    id: Integer,
    timestamp: String,
    value: Float,
    metadata: List<String>
};

-- Define the Processing Pipeline state
type PipelineState = {
    processed_count: Integer,
    error_count: Integer,
    last_processed: Maybe DataRecord
};

-- Main processing function
main(args: List<String>) {
    let input_file = if length(args) > 0 then args[0] else "input.dat";
    let output_file = if length(args) > 1 then args[1] else "output.dat";

    putStrLn "Starting Alice Data Processor...";
    
    try {
        let data = load_data(input_file);
        let processed_data = process_data(data);
        save_data(processed_data, output_file);
        putStrLn "Data processing completed successfully.";
    } catch (e: Exception) {
        handleError(e);
    }
}

-- Load data from file
load_data(filename: String) : List DataRecord = {
    let lines = read_file(filename);
    map(parse_line, lines);
}

-- Parse a single line into a DataRecord
parse_line(line: String) : DataRecord = {
    let parts = split(line, ',');
    {
        id = parseInt(parts[0]),
        timestamp = parts[1],
        value = parseFloat(parts[2]),
        metadata = drop(parts, 3)
    }
}

-- Process data through the pipeline
process_data(records: List DataRecord) : List DataRecord = {
    let filtered = filter(filter_valid, records);
    let transformed = map(transform_value, filtered);
    let sorted = sort_by_timestamp(transformed);
    return sorted;
}

-- Filter out invalid records
filter_valid(record: DataRecord) : Boolean = {
    record.id != 0 && record.value >= 0.0;
}

-- Transform the value (example: multiply by 1.5)
transform_value(record: DataRecord) : DataRecord = {
    {
        id: record.id,
        timestamp: record.timestamp,
        value: record.value * 1.5,
        metadata: record.metadata
    }
}

-- Sort records by timestamp
sort_by_timestamp(records: List DataRecord) : List DataRecord = {
    sort((r1: DataRecord, r2: DataRecord) => compare(r1.timestamp, r2.timestamp), records);
}

-- Save processed data to file
save_data(records: List DataRecord, filename: String) = {
    let lines = map(format_record, records);
    write_file(filename, join(lines, '\n'));
}

-- Format a DataRecord back to a string line
format_record(record: DataRecord) : String = {
    join([
        toString(record.id),
        record.timestamp,
        toString(record.value),
        join(record.metadata, ',')
    ], ',');
}

-- Error handling
declare function handleError(e: Exception);
function handleError(e: Exception) = {
    let msg = format_error(e);
    writeFile("error.log", msg);
    halt(1);
}

function format_error(e: Exception) = {
    "Error: " + toString(e.message) + " at " + e.location;
}
