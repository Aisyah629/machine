// Alice Memory Management and Network Protocol Simulator
// This program simulates low-level memory management and network protocols

// Memory Block Structure
memory_block = {
    base_address: 0,
    size: 0,
    allocated: false,
    process_id: 0
}

// Packet Structure
packet = {
    source_address: 0,
    destination_address: 0,
    data: [],
    checksum: 0,
    acknowledged: false
}

// Memory Manager Class
memory_manager = {
    blocks: [],
    total_memory: 1024,
    allocation_strategy: "first-fit",
    
    // Initialize memory manager
    init: function()
        this.blocks = []
        this.add_block(0, this.total_memory)
    end,
    
    // Add a memory block
    add_block: function(base, size)
        block = memory_block(base, size, false, 0)
        this.blocks.push(block)
    end,
    
    // Allocate memory using first-fit strategy
    first_fit_allocate: function(size, process_id)
        for i from 0 to length(this.blocks) - 1
            if not this.blocks[i].allocated and this.blocks[i].size >= size
                // Split block if necessary
                if this.blocks[i].size > size
                    this.split_block(i, size)
                end
                this.blocks[i].allocated = true
                this.blocks[i].process_id = process_id
                return this.blocks[i].base_address
            end
        end
        return -1  // Allocation failed
    end,
    
    // Allocate memory using best-fit strategy
    best_fit_allocate: function(size, process_id)
        best_index = -1
        best_size = this.total_memory + 1
        
        for i from 0 to length(this.blocks) - 1
            if not this.blocks[i].allocated and this.blocks[i].size >= size
                if this.blocks[i].size < best_size
                    best_size = this.blocks[i].size
                    best_index = i
                end
            end
        end
        
        if best_index >= 0
            if this.blocks[best_index].size > size
                this.split_block(best_index, size)
            end
            this.blocks[best_index].allocated = true
            this.blocks[best_index].process_id = process_id
            return this.blocks[best_index].base_address
        end
        return -1  // Allocation failed
    end,
    
    // Split a block
    split_block: function(index, allocated_size)
        block = this.blocks[index]
        remaining_size = block.size - allocated_size
        if remaining_size > 0
            this.blocks.push(memory_block(
                block.base_address + allocated_size,
                remaining_size,
                false,
                0
            ))
            block.size = allocated_size
        end
    end,
    
    // Free memory
    free_block: function(address)
        for i from 0 to length(this.blocks) - 1
            if this.blocks[i].base_address == address
                this.blocks[i].allocated = false
                this.blocks[i].process_id = 0
                return true
            end
        end
        return false
    end,
    
    // Merge adjacent free blocks
    merge_blocks: function()
        i = 0
        while i < length(this.blocks) - 1
            if not this.blocks[i].allocated and not this.blocks[i+1].allocated
                this.blocks[i].size += this.blocks[i+1].size
                this.blocks.delete(i+1)
            else
                i = i + 1
            end
        end
    end,
    
    // Get memory statistics
    get_stats: function()
        total_size = 0
        free_size = 0
        allocated_size = 0
        fragments = 0
        
        for i from 0 to length(this.blocks) - 1
            total_size = total_size + this.blocks[i].size
            if not this.blocks[i].allocated
                free_size = free_size + this.blocks[i].size
                fragments = fragments + 1
            else
                allocated_size = allocated_size + this.blocks[i].size
            end
        end
        
        return {
            total: total_size,
            free: free_size,
            allocated: allocated_size,
            fragments: fragments
        }
    end
}

// Network Protocol Simulator
network_protocol = {
    connections: [],
    packets: [],
    packet_id: 0,
    
    // Initialize network protocol
    init: function()
        this.connections = []
        this.packets = []
        this.packet_id = 0
    end,
    
    // Create a connection
    create_connection: function(source, destination)
        connection = {
            id: length(this.connections),
            source: source,
            destination: destination,
            state: "established",
            sequence_number: 0,
            acknowledgments: []
        }
        this.connections.push(connection)
        return connection.id
    end,
    
    // Send a packet
    send_packet: function(connection_id, data)
        if connection_id < length(this.connections)
            connection = this.connections[connection_id]
            packet = packet(
                connection.source,
                connection.destination,
                data,
                this.calculate_checksum(data),
                false
            )
            packet.id = this.packet_id
            this.packet_id = this.packet_id + 1
            this.packets.push(packet)
            return packet.id
        end
        return -1
    end,
    
    // Calculate packet checksum
    calculate_checksum: function(data)
        checksum = 0
        for i from 0 to length(data) - 1
            checksum = checksum + data[i]
        end
        return checksum
    end,
    
    // Process packet
    process_packet: function(packet_id)
        for i from 0 to length(this.packets) - 1
            if this.packets[i].id == packet_id
                // Simulate 10% packet loss
                if random() < 0.1
                    this.packets[i].data = "LOST"
                    return false
                end
                
                // Verify checksum
                calculated_checksum = this.calculate_checksum(this.packets[i].data)
                if calculated_checksum != this.packets[i].checksum
                    this.packets[i].data = "CORRUPTED"
                    return false
                end
                
                // Acknowledge packet
                this.packets[i].acknowledged = true
                return true
            end
        end
        return false
    end,
    
    // Get network statistics
    get_stats: function()
        total_packets = length(this.packets)
        successful_packets = 0
        lost_packets = 0
        corrupted_packets = 0
        
        for i from 0 to length(this.packets) - 1
            if this.packets[i].data == "LOST"
                lost_packets = lost_packets + 1
            else if this.packets[i].data == "CORRUPTED"
                corrupted_packets = corrupted_packets + 1
            else if this.packets[i].acknowledged
                successful_packets = successful_packets + 1
            end
        end
        
        return {
            total: total_packets,
            successful: successful_packets,
            lost: lost_packets,
            corrupted: corrupted_packets
        }
    end
}

// Main execution
main = function()
    // Initialize simulators
    mem_manager = memory_manager()
    mem_manager.init()
    
    net_protocol = network_protocol()
    net_protocol.init()
    
    // Test Memory Management
    print("=== Memory Management Test ===")
    print("Total Memory: " + mem_manager.total_memory)
    print("Initial Statistics: " + json(mem_manager.get_stats()))
    
    // Allocate memory
    addr1 = mem_manager.first_fit_allocate(100, 1)
    print("Allocated 100 bytes for process 1 at address: " + addr1)
    
    addr2 = mem_manager.first_fit_allocate(200, 2)
    print("Allocated 200 bytes for process 2 at address: " + addr2)
    
    addr3 = mem_manager.first_fit_allocate(150, 3)
    print("Allocated 150 bytes for process 3 at address: " + addr3)
    
    print("After allocations: " + json(mem_manager.get_stats()))
    
    // Free some memory
    mem_manager.free_block(addr2)
    mem_manager.merge_blocks()
    print("After freeing process 2: " + json(mem_manager.get_stats()))
    
    // Test Network Protocol
    print("\n=== Network Protocol Test ===")
    
    conn_id = net_protocol.create_connection(1, 2)
    print("Created connection with ID: " + conn_id)
    
    // Send packets
    packet1_id = net_protocol.send_packet(conn_id, [72, 101, 108, 108, 111])  // "Hello"
    print("Sent packet 1 with ID: " + packet1_id)
    
    packet2_id = net_protocol.send_packet(conn_id, [87, 111, 114, 108, 100])  // "World"
    print("Sent packet 2 with ID: " + packet2_id)
    
    // Process packets
    success1 = net_protocol.process_packet(packet1_id)
    print("Packet 1 processed successfully: " + success1)
    
    success2 = net_protocol.process_packet(packet2_id)
    print("Packet 2 processed successfully: " + success2)
    
    print("Network Statistics: " + json(net_protocol.get_stats()))
end

// Run main function
main()
