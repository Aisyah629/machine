// Nekodata Data Processing Tool
// This script demonstrates data processing capabilities in Neko

import sys
import std/io
import std/math
import std/string

// Data structure for records
type DataRecord = {
    id: Int,
    name: String,
    value: Float,
    category: String
}

// Parse a line of CSV data
function parseCSVLine(line: String): DataRecord {
    var parts = string.split(line, ",");
    if (parts.length < 4) {
        throw "Invalid CSV line: " + line;
    }
    return {
        id: string.parseInt(parts[0]),
        name: parts[1],
        value: string.parseFloat(parts[2]),
        category: parts[3]
    };
}

// Process a list of records
function processRecords(records: Array<DataRecord>): Array<DataRecord> {
    var results = [];
    for (var i = 0; i < records.length; i++) {
        var rec = records[i];
        // Example transformation: double the value
        rec.value = rec.value * 2.0;
        results.push(rec);
    }
    return results;
}

// Main entry point
function main() {
    if (sys.args.length < 1) {
        sys.stderr.println("Usage: neko main.neko <input_file>");
        sys.exit(1);
    }
    
    var inputFile = sys.args[0];
    try {
        var file = io.openRead(inputFile);
        var lines = [];
        try {
            while (true) {
                lines.push(file.readLine());
            }
        } catch (e: Dynamic) {
            // End of file
        }
        file.close();
        
        // Skip header line if present
        if (lines.length > 0 && lines[0].indexOf("id") == 0) {
            lines = lines.slice(1);
        }
        
        var records = [];
        for (var i = 0; i < lines.length; i++) {
            try {
                records.push(parseCSVLine(lines[i]));
            } catch (e: Dynamic) {
                sys.stderr.println("Warning: Skipping invalid line: " + lines[i]);
            }
        }
        
        var processed = processRecords(records);
        
        // Output results
        for (var i = 0; i < processed.length; i++) {
            var rec = processed[i];
            sys.stdout.println(rec.id + "," + rec.name + "," + rec.value.toFixed(2) + "," + rec.category);
        }
        
    } catch (e: Dynamic) {
        sys.stderr.println("Error: " + e);
        sys.exit(1);
    }
}

main();
