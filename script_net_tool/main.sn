// Script.NET Main Entry Point
// This script initializes the tool environment and handles core execution logic.

using System;
using System.IO;
using ScriptNET.Runtime;

public class Program
{
    public static void Main(string[] args)
    {
        Console.WriteLine("Initializing Script.NET Tool Environment...");
        
        try
        {
            // Load configuration and validate environment
            var config = ToolConfig.Load();
            
            // Register core language services
            LanguageRegistry.Register(typeof(CoreServices));
            
            // Execute provided script or run in interactive mode
            if (args.Length > 0)
            {
                string scriptPath = args[0];
                if (File.Exists(scriptPath))
                {
                    Console.WriteLine($"Executing script: {scriptPath}");
                    ScriptExecutor.Run(scriptPath);
                }
                else
                {
                    Console.WriteLine("Error: Specified script file not found.");
                    Environment.Exit(1);
                }
            }
            else
            {
                Console.WriteLine("Running in interactive mode. Use '.help' for commands.");
                InteractiveShell.Start();
            }
            
            Console.WriteLine("Script.NET Tool completed successfully.");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"FATAL ERROR: {ex.Message}");
            Environment.Exit(2);
        }
    }
}
