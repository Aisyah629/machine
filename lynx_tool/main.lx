// Lynx Script for HTTP Automation
// filename: main.lx

import network.http
import data.json

// Configuration
const TIMEOUT = 30000
const MAX_RETRIES = 3

// HTTP Client Class
class HttpClient {
    constructor(base_url, headers) {
        this.base_url = base_url;
        this.headers = headers || {};
        this.cookies = new Map();
    }

    async get(path, query_params = {}) {
        const url = this.build_url(path, query_params);
        const response = await network.http.request('GET', url, {
            headers: { ...this.headers, 'Cookie': this.encode_cookies() },
            timeout: TIMEOUT
        });
        return this.handle_response(response);
    }

    async post(path, body = {}) {
        const url = this.build_url(path);
        const response = await network.http.request('POST', url, {
            headers: { ...this.headers, 'Content-Type': 'application/json', 'Cookie': this.encode_cookies() },
            body: JSON.stringify(body),
            timeout: TIMEOUT
        });
        return this.handle_response(response);
    }

    build_url(path, query_params) {
        let url = this.base_url + path;
        if (query_params) {
            const params = new URLSearchParams(query_params).toString();
            if (params) url += '?' + params;
        }
        return url;
    }

    encode_cookies() {
        let cookies = '';
        for (let [key, value] of this.cookies) {
            cookies += key + '=' + value + '; ';
        }
        return cookies;
    }

    async handle_response(response) {
        if (response.status >= 400) {
            throw new Error('HTTP Error: ' + response.status);
        }
        // Update cookies
        if (response.headers['set-cookie']) {
            this.parse_cookies(response.headers['set-cookie']);
        }
        return {
            status: response.status,
            data: response.data,
            headers: response.headers
        };
    }

    parse_cookies(set_cookie_str) {
        // Simplified cookie parsing
        const pairs = set_cookie_str.split(',');
        for (let pair of pairs) {
            const [key, value] = pair.split('=');
            if (key && value) {
                this.cookies.set(key.trim(), value.trim().split(';')[0].trim());
            }
        }
    }
}

// Web Scraper Class
class WebScraper extends HttpClient {
    constructor(base_url) {
        super(base_url, { 'User-Agent': 'LynxScraper/1.0' });
    }

    async scrape_page(url) {
        const response = await this.get(url);
        return response.data;
    }

    async scrape_multiple_urls(urls) {
        const promises = urls.map(url => this.scrape_page(url));
        return await Promise.all(promises);
    }
}

// API Client Class
class ApiClient extends HttpClient {
    constructor(base_url, api_key) {
        super(base_url, { 'Authorization': 'Bearer ' + api_key });
    }

    async get_resource(resource_id) {
        return await this.get('/resources/' + resource_id);
    }

    async create_resource(data) {
        return await this.post('/resources', data);
    }
}

// Main Entry Point
async function main() {
    // Example usage
    const scraper = new WebScraper('https://example.com');
    try {
        const page = await scraper.scrape_page('/home');
        console.log('Scraped page:', page);
    } catch (error) {
        console.error('Scraping failed:', error.message);
    }

    const client = new ApiClient('https://api.example.com', 'your-api-key');
    try {
        const resource = await client.get_resource('123');
        console.log('Fetched resource:', resource.data);
    } catch (error) {
        console.error('API request failed:', error.message);
    }
}

// Run
if (typeof window === 'undefined') {
    main().catch(console.error);
}
