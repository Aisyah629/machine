// Draco Data Processing Utility
// Main entry point for data processing operations

import io
import data
import transform

struct DataRecord {
    id: string
    value: float64
    timestamp: int64
    metadata: map<string, string>
}

struct ProcessingPipeline {
    name: string
    steps: list<function(DataRecord) -> DataRecord>
}

function initialize_pipeline(name: string) -> ProcessingPipeline {
    return ProcessingPipeline(name, [])
}

function add_step(pipeline: ProcessingPipeline, step_function: function(DataRecord) -> DataRecord) -> void {
    pipeline.steps.add(step_function)
}

function validate_record(record: DataRecord) -> bool {
    if record.id == "" {
        return false
    }
    if record.value < 0.0 {
        return false
    }
    return true
}

function transform_record(record: DataRecord, factor: float64) -> DataRecord {
    record.value = record.value * factor
    return record
}

function process_data(input_data: list<DataRecord>, pipeline: ProcessingPipeline) -> list<DataRecord> {
    let results: list<DataRecord> = []
    
    for record in input_data {
        if validate_record(record) {
            let current_record = record
            for step in pipeline.steps {
                current_record = step(current_record)
            }
            results.add(current_record)
        }
    }
    
    return results
}

function main() {
    let initial_pipeline = initialize_pipeline("standard_transform")
    add_step(initial_pipeline, transform_record)
    
    let sample_data: list<DataRecord> = [
        {"id": "rec_001", "value": 10.5, "timestamp": 1712345678, "metadata": {"source": "sensor_1"}},
        {"id": "rec_002", "value": 20.3, "timestamp": 1712345679, "metadata": {"source": "sensor_2"}},
        {"id": "", "value": 15.0, "timestamp": 1712345680, "metadata": {"source": "invalid"}},
        {"id": "rec_003", "value": -5.2, "timestamp": 1712345681, "metadata": {"source": "sensor_3"}}
    ]
    
    let processed = process_data(sample_data, initial_pipeline)
    
    io.println("Processing complete. Records processed: " + str(len(processed)))
    for record in processed {
        io.println("Processed Record: " + record.id + " -> Value: " + str(record.value))
    }
}

main()
