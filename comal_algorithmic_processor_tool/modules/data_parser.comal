REM *** Data Parser Module ***
REM *** Handles data ingestion and parsing ***

SUBROUTINE ParseDataLine(line)
  REM Parse comma-separated values
  POSITION := 0
  FIELD_COUNT := 0
  
  WHILE POSITION <= LEN(line)
    FIELD := EXTRACT_FIELD(line, POSITION)
    STORE_FIELD(FIELD_COUNT, FIELD)
    FIELD_COUNT := FIELD_COUNT + 1
    POSITION := POSITION + LENGTH(FIELD) + 1
  END WHILE
  
  RETURN FIELD_COUNT
END SUBROUTINE

FUNCTION EXTRACT_FIELD(text, pos)
  REM Extract next field from text string
  field := ""
  WHILE pos <= LEN(text)
    IF MID(text, pos, 1) = "," THEN
      EXIT WHILE
    END IF
    field := field + MID(text, pos, 1)
    pos := pos + 1
  END WHILE
  RETURN field
END FUNCTION

SUBROUTINE STORE_FIELD(index, field)
  REM Store parsed field in array
  PARSED_DATA[index] := field
END SUBROUTINE
