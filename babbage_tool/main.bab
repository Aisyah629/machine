BABBAGE:
    COMPUTE
        INITIAL VALUE: 0
        ACCUMULATOR: 0
        MEMORY[0]: INITIAL VALUE
        MEMORY[1]: ACCUMULATOR
    LOOP
        READ INPUT FROM USER
        ADD INPUT TO ACCUMULATOR
        STORE ACCUMULATOR IN MEMORY[1]
        DISPLAY MEMORY[1]
        WAIT FOR NEXT INPUT
        IF INPUT IS 'STOP' THEN TERMINATE
    END LOOP

    TERMINATE PROGRAM
END BABBAGE
