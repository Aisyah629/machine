/*************************************************************************
*   Tool: RobotC Development Tool
*   Objective: Develop a deterministic control logic system for collaborative 
*              multi-agent robotic swarms.
*   Language: RobotC
*************************************************************************/

#include "robotc.h"

// Swarm configuration parameters
#define MAX_AGENTS 10
#define COMM_RANGE 50.0
#define SAFE_DISTANCE 25.0

// Global state for swarm coordination
typedef struct {
    int agent_id;
    float x, y, z;
    bool is_leader;
    float battery_level;
    int task_queue[5];
} SwarmAgent;

SwarmAgent agents[MAX_AGENTS];

// Forward declarations
void initializeSwarm(SwarmAgent agents[], int count);
void communicateWithNeighbors(SwarmAgent *me, SwarmAgent others[], int count);
void calculateCollisionVector(SwarmAgent *me, SwarmAgent other);
void executeLeaderTask(SwarmAgent *leader, SwarmAgent followers[], int follower_count);
void monitorBatteryLevels(SwarmAgent agents[], int count);

#pragma mainTask
void main() {
    // Initialize the swarm
    initializeSwarm(agents, MAX_AGENTS);
    
    // Main swarm loop
    while (true) {
        // 1. Communication Phase: Share status with nearby agents
        for (int i = 0; i < MAX_AGENTS; i++) {
            if (agents[i].battery_level > 10.0) { // Only active agents
                communicateWithNeighbors(&agents[i], agents, MAX_AGENTS);
            }
        }
        
        // 2. Coordination Phase: Leader assigns tasks if leader is active
        SwarmAgent *leader = null;
        for (int i = 0; i < MAX_AGENTS; i++) {
            if (agents[i].is_leader) {
                leader = &agents[i];
                break;
            }
        }
        
        if (leader != null && leader->battery_level > 20.0) {
            // Pass followers by excluding the leader
            executeLeaderTask(leader, agents, MAX_AGENTS);
        }
        
        // 3. Safety Phase: Avoid collisions
        for (int i = 0; i < MAX_AGENTS; i++) {
            for (int j = 0; j < MAX_AGENTS; j++) {
                if (i != j && agents[i].battery_level > 0 && agents[j].battery_level > 0) {
                    calculateCollisionVector(&agents[i], agents[j]);
                }
            }
        }
        
        // 4. Maintenance Phase: Check battery and manage swarming
        monitorBatteryLevels(agents, MAX_AGENTS);
        
        wait1Msec(100); // Standard loop delay for control stability
    }
}

void initializeSwarm(SwarmAgent agents[], int count) {
    for (int i = 0; i < count; i++) {
        agents[i].agent_id = i + 1;
        agents[i].x = 0;
        agents[i].y = 0;
        agents[i].z = 0;
        agents[i].is_leader = (i == 0); // First agent is leader
        agents[i].battery_level = 100.0;
        memset(agents[i].task_queue, 0, sizeof(agents[i].task_queue));
    }
}

void communicateWithNeighbors(SwarmAgent *me, SwarmAgent others[], int count) {
    // Simplified simulation of sensor data
    // In real hardware, this would read from I2C, Ultrasonic, or Gyro sensors
    me->battery_level -= 0.1; // Simulate battery drain during comms
}

void calculateCollisionVector(SwarmAgent *me, SwarmAgent other) {
    float dx = other.x - me->x;
    float dy = other.y - me->y;
    float dz = other.z - me->z;
    float dist = sqrt(dx*dx + dy*dy + dz*dz);
    
    if (dist < SAFE_DISTANCE) {
        // Logic to adjust motors would go here
        // Turn away from other agent
    }
}

void executeLeaderTask(SwarmAgent *leader, SwarmAgent followers[], int count) {
    // Leader distributes tasks based on battery level and current position
    int task_counter = 0;
    for (int i = 0; i < count; i++) {
        if (leader->agent_id != followers[i].agent_id) {
            followers[i].task_queue[task_counter] = 1; // Example task ID
            task_counter++;
        }
    }
}

void monitorBatteryLevels(SwarmAgent agents[], int count) {
    for (int i = 0; i < count; i++) {
        if (agents[i].battery_level <= 10.0) {
            agents[i].is_leader = false;
            // Logic to send agent to charging station would go here
        }
    }
}
