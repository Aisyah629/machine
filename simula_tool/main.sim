! Main Simula program for Object-Oriented Task Scheduling and Resource Management ;

class TaskManager;
    class Task;
    class Resource;
    class Scheduler;
    class Monitor;

class Task;
    virtual procedure execute ;
    boolean completed ;
    integer priority ;
    integer id ;
end ;

class Resource;
    string name ;
    boolean available ;
    integer capacity ;
end ;

class Scheduler ;
    array tasks of reference to Task ;
    array resources of reference to Resource ;
    procedure schedule (task) ;
        Task task ;
        tasks append (task) ;
        tasks sort by priority ;
    end schedule ;
    procedure allocateResources (task) ;
        Task task ;
        loop while not all resources available do begin
            wait for resource availability ;
            mark resources as used ;
        end ;
    end allocateResources ;
    procedure releaseResources (task) ;
        Task task ;
        mark resources as available ;
    end releaseResources ;
    procedure runScheduler () ;
        loop while tasks not empty do begin
            task = tasks removeFirst () ;
            allocateResources (task) ;
            task.execute () ;
            task.completed = true ;
            releaseResources (task) ;
        end ;
    end runScheduler ;
end Scheduler ;

class Monitor ;
    reference to Scheduler schedulerRef ;
    procedure checkSystemHealth () ;
        if schedulerRef not defined or schedulerRef tasks empty then
            outputLine ("System idle. Running maintenance tasks.") ;
        else
            outputLine ("System operational. Active tasks: " + schedulerRef tasks length) ;
        end if ;
    end checkSystemHealth ;
end Monitor ;

class TaskManager ;
    reference to Scheduler sched ;
    reference to Monitor mon ;
    procedure createTask (id, priority) ;
        integer id, priority ;
        ref Task newTask = new Task () ;
        newTask.id = id ;
        newTask.priority = priority ;
        sched.schedule (newTask) ;
    end createTask ;
    procedure startExecution () ;
        sched.runScheduler () ;
    end startExecution ;
    procedure checkStatus () ;
        mon.checkSystemHealth () ;
    end checkStatus ;
end TaskManager ;

begin
    ref TaskManager mgr = new TaskManager () ;
    mgr.sched = new Scheduler () ;
    mgr.mon = new Monitor () ;
    mgr.mon.schedulerRef = mgr.sched ;
    mgr.createTask (1, 3) ;
    mgr.createTask (2, 1) ;
    mgr.createTask (3, 2) ;
    mgr.startExecution () ;
    mgr.checkStatus () ;
end
