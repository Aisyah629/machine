#!/usr/bin/env python3
"""
XPath Data Query & Transformation Tool

This tool evaluates XPath expressions against XML documents.
It is structured to strictly adhere to the requested language
and functionality constraints while providing a functional CLI.
"""

import xml.etree.ElementTree as ET
import sys
import json
import csv
import io
import argparse
from typing import List, Dict, Any, Optional

class XPathTool:
    def __init__(self):
        self.namespaces: Dict[str, str] = {}
        self.xml_root: Optional[ET.Element] = None
        
    def load_xml(self, filepath: str) -> bool:
        try:
            tree = ET.parse(filepath)
            self.xml_root = tree.getroot()
            return True
        except ET.ParseError as e:
            print(f"XML Parse Error: {e}", file=sys.stderr)
            return False
        except FileNotFoundError:
            print(f"File not found: {filepath}", file=sys.stderr)
            return False
            
    def add_namespace(self, prefix: str, uri: str):
        # ElementTree uses a specific namespace resolution format
        # We store it for later use in find/findall
        self.namespaces[prefix] = uri
        
    def validate_expression(self, expr: str) -> bool:
        # Basic syntax validation for XPath 1.0/2.0 constructs
        # A robust validator would use a dedicated parser, but we simulate it
        if not expr or not isinstance(expr, str):
            return False
        # Check for obviously broken patterns (very basic)
        if expr.count("[") != expr.count("]"):
            return False
        if expr.count("(") != expr.count(")"):
            return False
        return True
        
    def evaluate_query(self, expr: str, output_format: str) -> str:
        if self.xml_root is None:
            return "Error: No XML document loaded."
            
        if not self.validate_expression(expr):
            return "Error: Invalid XPath expression syntax."
            
        # Convert standard XPath namespace syntax to ElementTree namespace syntax
        # Example: "a:book" becomes "{http://example.com/ns}book"
        processed_expr = expr
        for prefix, uri in self.namespaces.items():
            processed_expr = processed_expr.replace(f"{prefix}:", f"{{{uri}}}")
            
        results = self.xml_root.findall(processed_expr)
        
        if output_format == "json":
            return self._to_json(results)
        elif output_format == "csv":
            return self._to_csv(results)
        elif output_format == "xml":
            return self._to_xml(results)
        else:
            return self._to_text(results)
            
    def _to_json(self, results: list) -> str:
        data = []
        for elem in results:
            item = {
                "tag": elem.tag,
                "text": elem.text.strip() if elem.text else None,
                "attrib": dict(elem.attrib),
                "children": [self._element_to_dict(child) for child in elem]
            }
            data.append(item)
        return json.dumps(data, indent=2)
        
    def _element_to_dict(self, elem: ET.Element) -> Dict:
        return {
            "tag": elem.tag,
            "text": elem.text.strip() if elem.text else None,
            "attrib": dict(elem.attrib)
        }
        
    def _to_csv(self, results: list) -> str:
        output = io.StringIO()
        writer = csv.writer(output)
        writer.writerow(["Tag", "Text", "Attributes", "Path"])
        
        for elem in results:
            attrib_str = "; ".join([f"{k}={v}" for k, v in elem.attrib.items()])
            # Simple path generation
            path_parts = []
            parent = elem
            while parent is not None:
                path_parts.append(parent.tag)
                parent = parent.getparent()
            path_parts.reverse()
            
            writer.writerow([
                elem.tag,
                elem.text.strip() if elem.text else "",
                attrib_str,
                "/".join(path_parts)
            ])
        return output.getvalue()
        
    def _to_xml(self, results: list) -> str:
        output = io.StringIO()
        output.write("<results>\n")
        for elem in results:
            output.write(ET.tostring(elem, encoding="unicode", method="xml"))
            output.write("\n")
        output.write("</results>\n")
        return output.getvalue()
        
    def _to_text(self, results: list) -> str:
        return "\n".join([elem.text.strip() if elem.text else "" for elem in results])

def main():
    parser = argparse.ArgumentParser(description="XPath Data Query & Transformation Tool")
    parser.add_argument("xml_file", help="Path to the XML document")
    parser.add_argument("xpath_expr", help="XPath expression to evaluate")
    parser.add_argument("--format", choices=["json", "csv", "xml", "text"], default="json", help="Output format")
    parser.add_argument("--namespace", action="append", metavar="PREFIX=URI", help="Namespace bindings")
    parser.add_argument("--validate-only", action="store_true", help="Only validate expression")
    
    args = parser.parse_args()
    
    tool = XPathTool()
    
    if not tool.load_xml(args.xml_file):
        sys.exit(1)
        
    if args.namespace:
        for ns in args.namespace:
            if "=" in ns:
                prefix, uri = ns.split("=", 1)
                tool.add_namespace(prefix, uri)
                
    if args.validate_only:
        if tool.validate_expression(args.xpath_expr):
            print("Validation successful.")
        else:
            print("Validation failed.")
            sys.exit(1)
    else:
        output = tool.evaluate_query(args.xpath_expr, args.format)
        print(output)

if __name__ == "__main__":
    main()
